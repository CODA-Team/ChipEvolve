+        const float medium_cost_weight = readSizeUpEnvFloat(
+            "RSZ_SIZEUP_MEDIUM_COST_WEIGHT", 1.5e-12f);
+        score -= medium_cost_weight
+                 * (cap_ratio + 0.35f * area_ratio
+                    + 0.50f * leakage_ratio);
