+  return value != nullptr && string(value) != "0";
+}
+
+float weakSizeupDriverBoost(const sta::LibertyCell* cell)
+{
+  if (cell == nullptr || !rankWeakSizeupDrivers()) {
+    return 0.0f;
+  }
+
+  const string name = cell->name();
+  float boost = 0.0f;
+  if (name.find("xp33") != string::npos
+      || name.find("XP33") != string::npos) {
+    boost = std::max(boost, 1.5e-11f);
+  } else if (name.find("xp5") != string::npos
+             || name.find("XP5") != string::npos) {
+    boost = std::max(boost, 6.0e-12f);
+  }
+  if (boost > 0.0f
+      && (name.find("_R") != string::npos
+          || name.find("_RVT") != string::npos)) {
+    boost += 4.0e-12f;
+  }
+  return boost;
+}
