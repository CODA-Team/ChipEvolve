+    float score = delay_gain;
+    if (policy_config_.timing_power_aware_scoring) {
+      const float leakage_ratio = growthRatio(current_leakage,
+                                              swappable_leakage);
+      const float leakage_reduction = reductionRatio(current_leakage,
+                                                     swappable_leakage);
