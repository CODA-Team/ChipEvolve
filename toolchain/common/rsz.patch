+bool Resizer::drivesSequentialClockPin(const sta::Instance* inst) const
+{
+  if (inst == nullptr || graph_ == nullptr) {
+    return false;
+  }
+
+  std::unique_ptr<sta::InstancePinIterator> pin_iter(
+      network_->pinIterator(inst));
+  while (pin_iter->hasNext()) {
+    const sta::Pin* pin = pin_iter->next();
+    if (!network_->direction(pin)->isAnyOutput()) {
+      continue;
+    }
+
+    sta::Vertex* vertex = graph_->pinDrvrVertex(pin);
+    if (vertex == nullptr) {
+      continue;
+    }
+    sta::VertexOutEdgeIterator edge_iter(vertex, graph_);
+    while (edge_iter.hasNext()) {
+      sta::Edge* edge = edge_iter.next();
+      if (!edge->isWire()) {
+        continue;
+      }
+      sta::Vertex* fanout_vertex = edge->to(graph_);
+      if (fanout_vertex != nullptr && fanout_vertex->isRegClk()) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
