+sta::define_cmd_args "repair_power" {[-phase early_forced_reclaim|mid_area_reclaim|late_leakage_recovery]\
+                                      [-proportion candidate_percent]\
+                                      [-max_moves moves]\
+                                      [-max_tns_expand_ratio ratio]\
+                                      [-max_wns_drop drop]\
+                                      [-max_utilization util]\
+                                      [-match_cell_footprint]\
+                                      [-verbose]}
+
+proc repair_power { args } {
+  sta::parse_key_args "repair_power" args \
+    keys {-phase -proportion -max_moves -max_tns_expand_ratio -max_wns_drop \
+            -max_utilization} \
+    flags {-match_cell_footprint -verbose}
+
+  set phase "early_forced_reclaim"
+  if { [info exists keys(-phase)] } {
+    set phase $keys(-phase)
+  }
+  if { $phase ne "early_forced_reclaim" && \
+       $phase ne "mid_area_reclaim" && \
+       $phase ne "late_leakage_recovery" } {
+    utl::error RSZ 2310 \
+      "unknown repair_power -phase '$phase'. Valid phases are: early_forced_reclaim, mid_area_reclaim, late_leakage_recovery."
+  }
+
+  set proportion 80.0
+  if { [info exists keys(-proportion)] } {
+    set proportion $keys(-proportion)
+  }
+  sta::check_percent "-proportion" $proportion
+  set proportion [expr $proportion / 100.0]
+
+  set max_moves 0
+  if { [info exists keys(-max_moves)] } {
+    set max_moves $keys(-max_moves)
+    sta::check_positive_integer "-max_moves" $max_moves
+  }
+
+  set max_tns_expand_ratio 0.0
+  if { [info exists keys(-max_tns_expand_ratio)] } {
+    set max_tns_expand_ratio $keys(-max_tns_expand_ratio)
+  }
+
+  set max_wns_drop 0.0
+  if { [info exists keys(-max_wns_drop)] } {
+    set max_wns_drop [sta::time_ui_sta $keys(-max_wns_drop)]
+  }
+
+  rsz::set_max_utilization [rsz::parse_max_util keys]
+  set match_cell_footprint [info exists flags(-match_cell_footprint)]
+  set verbose [info exists flags(-verbose)]
+
+  if { [design_is_routed] } {
+    est::set_parasitics_src "detailed_routing"
+  }
+  sta::check_argc_eq0 "repair_power" $args
+  est::check_parasitics
+
+  return [rsz::repair_power $phase $proportion $max_moves \
+    $max_tns_expand_ratio $max_wns_drop $match_cell_footprint $verbose]
+}
