#!/usr/bin/env bash
# Copy to env.sh for machine-local settings. env.sh is ignored by git.

# Required runtime roots.
export DPL_EVOLVE_AGENT_ROOT="/abs/path/to/dpl_evolve_agent"
export ORFS_ROOT="/abs/path/to/OpenROAD-flow-scripts"
# Runtime state is local/generated and ignored by git.  Prefer keeping it
# inside this control repo instead of inside ORFS, so ORFS can stay clean.
export DPL_EVOLVE_STATE_ROOT="${DPL_EVOLVE_AGENT_ROOT}/.dpl_evolve_state"

# Optional: if ORFS_ROOT contains spaces, this must be a space-free symlink path
# that scripts can use while invoking make/CMake.
# export DPL_EVOLVE_ORFS_ALIAS_ROOT="/abs/path/without/spaces/orfs_mount"

# Optional: override a stale/local tools/OpenROAD submodule URL during prepare.
# export DPL_EVOLVE_OPENROAD_URL="https://github.com/The-OpenROAD-Project/OpenROAD.git"

# Optional: interpreter candidates used only when the current Python cannot
# import a required module such as PyYAML. Separate entries with ':'.
# export DPL_EVOLVE_PYTHON_CANDIDATES="/path/to/python3:/another/python"

# Optional: DreamPlace baseline support. Leave unset if you do not run
# dreamplace_default.
# export DREAMPLACE_ROOT="/abs/path/to/DREAMPlace"
# export DREAMPLACE_PYTHON="/abs/path/to/python-with-torch"

# Optional: module setup for shells that support environment modules.
# module load openroad
