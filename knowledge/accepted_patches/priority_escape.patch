+bool NegotiationLegalizer::shouldUseEscapeSearch(int cell_idx, int iter) const
+{
+  const NegCell& cell = cells_[cell_idx];
+  if (iter < kIsolationPt) {
+    return false;
+  }
+  return pinCount(cell_idx) >= kEscapeSearchPinThreshold
+         || cell.displacement() >= kEscapeSearchDisplacementThreshold;
+}
