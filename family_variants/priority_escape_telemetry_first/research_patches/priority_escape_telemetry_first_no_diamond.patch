+
+void NegotiationLegalizer::resetPriorityEscapeTelemetry()
+{
+  priority_escape_stats_.assign(cells_.size(), PriorityEscapeStuckStats{});
+}
+
+void NegotiationLegalizer::recordFindBestResult(int cell_idx,
+                                                const FindBestResult& result)
+{
+  PriorityEscapeStuckStats& stats = priority_escape_stats_[cell_idx];
+  ++stats.find_best_calls;
+  if (result.no_valid_candidate) {
+    ++stats.no_valid_count;
+  }
+  if (result.returned_current) {
+    ++stats.returned_current_count;
+    ++stats.returned_current_streak;
+    stats.max_returned_current_streak
+        = std::max(stats.max_returned_current_streak,
+                   stats.returned_current_streak);
+  } else {
+    stats.returned_current_streak = 0;
+  }
+  stats.escape_attempted += result.escape_attempted ? 1 : 0;
+  stats.escape_accepted += result.escape_accepted ? 1 : 0;
+  stats.escape_rolled_back += result.escape_rolled_back ? 1 : 0;
+  stats.escape_candidate_cap_hits += result.escape_candidate_cap_hit ? 1 : 0;
+}
+
+bool NegotiationLegalizer::shouldTryPriorityEscape(int cell_idx) const
+{
+  const PriorityEscapeStuckStats& stats = priority_escape_stats_[cell_idx];
+  return stats.no_valid_count > 0 || stats.returned_current_streak >= 3;
+}
+
+FindBestResult NegotiationLegalizer::tryPriorityEscape(
+    int cell_idx,
+    int iter,
+    const FindBestResult& base)
+{
+  constexpr int kPriorityEscapeCandidateCap = 64;
+  constexpr int kPriorityEscapeMaxExtraDisp = 12;
+  FindBestResult result = base;
+  result.escape_attempted = true;
+
+  const NegCell& cell = cells_[cell_idx];
+  const int current_disp = cell.displacement();
+  int seen = 0;
+  double best_cost = base.cost;
+
+  auto tryEscape = [&](int tx, int ty) {
+    if (seen++ >= kPriorityEscapeCandidateCap) {
+      result.escape_candidate_cap_hit = true;
+      return;
+    }
+    if (!inDie(tx, ty, cell.width, cell.height) || !isValidRow(ty, cell, tx)
+        || !respectsFence(cell_idx, tx, ty)) {
+      return;
+    }
+    const int disp = std::abs(tx - cell.init_x) + std::abs(ty - cell.init_y);
+    if (disp > current_disp + kPriorityEscapeMaxExtraDisp) {
+      return;
+    }
+    const double cost = negotiationCost(cell_idx, tx, ty)
+                        + adaptivePf(iter) * static_cast<double>(disp);
+    if (cost < best_cost || result.no_valid_candidate) {
+      best_cost = cost;
+      result.x = tx;
+      result.y = ty;
+      result.cost = cost;
+      result.no_valid_candidate = false;
+      result.escape_accepted = true;
+    }
+  };
+
+  for (int dy = -adj_window_; dy <= adj_window_; ++dy) {
+    const int y = cell.y + dy;
+    tryEscape(0, y);
+    tryEscape(std::max(0, grid_w_ - cell.width), y);
+    tryEscape(cell.x - horiz_window_ - cell.width, y);
+    tryEscape(cell.x + horiz_window_ + cell.width, y);
+  }
+  if (result.escape_accepted && !isValidRow(result.y, cell, result.x)) {
+    result.escape_rolled_back = true;
+    result.escape_accepted = false;
+    result.x = base.x;
+    result.y = base.y;
+    result.cost = base.cost;
+  }
+  return result;
+}
+
+void NegotiationLegalizer::reportPriorityEscapeTelemetry() const
+{
+  int find_best_calls = 0;
+  int no_valid = 0;
+  int returned_current = 0;
+  int stuck_cells = 0;
+  int max_streak = 0;
+  int escape_attempted = 0;
+  int escape_accepted = 0;
+  int escape_rolled_back = 0;
+  int escape_cap_hits = 0;
+  for (const PriorityEscapeStuckStats& stats : priority_escape_stats_) {
+    find_best_calls += stats.find_best_calls;
+    no_valid += stats.no_valid_count;
+    returned_current += stats.returned_current_count;
+    max_streak = std::max(max_streak, stats.max_returned_current_streak);
+    if (stats.no_valid_count > 0 || stats.max_returned_current_streak >= 3) {
+      ++stuck_cells;
+    }
+    escape_attempted += stats.escape_attempted;
+    escape_accepted += stats.escape_accepted;
+    escape_rolled_back += stats.escape_rolled_back;
+    escape_cap_hits += stats.escape_candidate_cap_hits;
+  }
+  logger_->metric("priority_escape_telemetry_first__find_best_calls",
+                  find_best_calls);
+  logger_->metric("priority_escape_telemetry_first__find_best_no_valid",
+                  no_valid);
+  logger_->metric("priority_escape_telemetry_first__returned_current",
+                  returned_current);
+  logger_->metric("priority_escape_telemetry_first__stuck_cells", stuck_cells);
+  logger_->metric("priority_escape_telemetry_first__max_returned_current_streak",
+                  max_streak);
+  logger_->metric("priority_escape_telemetry_first__escape_attempted",
+                  escape_attempted);
+  logger_->metric("priority_escape_telemetry_first__escape_accepted",
+                  escape_accepted);
+  logger_->metric("priority_escape_telemetry_first__escape_rolled_back",
+                  escape_rolled_back);
+  logger_->metric("priority_escape_telemetry_first__escape_cap_hits",
+                  escape_cap_hits);
 }

