+bool AlmLegalizer::siteRectIsStaticPlaceable(const CellState& cell,
+                                             const GridRect& rect) const
+{
+  if (!isWithinCore(rect) || !satisfiesRailAlignment(cell, rect.ly)
+      || !satisfiesRegionConstraint(cell, rect)) {
+    return false;
+  }
+  if (cell.region.type == RegionType::kNone) {
+    if (rectHasStaticInvalidSites(rect) || overlapsFixedBlockage(rect)
+        || !firstRowSiteOrientOk(cell, rect)) {
+      return false;
+    }
+    return true;
+  }
+  if (overlapsFixedBlockage(rect)) {
+    return false;
+  }
+  return true;
+}
