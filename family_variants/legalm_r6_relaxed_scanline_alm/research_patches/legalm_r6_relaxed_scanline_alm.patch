+double AlmLegalizer::evaluateStage1RelaxedCost(const CellState& cell,
+                                               int cand_x,
+                                               int cand_y,
+                                               int overflow_sites) const
+{
+  const double displacement = static_cast<double>(
+      manhattanDisplacement(cell, cand_x, cand_y));
+  const GridRect rect{cand_x, cand_y, cand_x + cell.w, cand_y + cell.h};
+  int component_overflow = 0;
+  const int component_id = componentIdForRect(rect);
+  if (component_id >= 0) {
+    auto it = component_overflow_.find(component_id);
+    if (it != component_overflow_.end()) {
+      component_overflow = std::max(0, it->second);
+    }
+  }
+  return displacement
+         + params_.stage1_overflow_weight * static_cast<double>(overflow_sites)
+         + params_.stage1_component_overflow_weight
+               * static_cast<double>(component_overflow);
+}
