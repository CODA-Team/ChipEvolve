+AlmLegalizer::Candidate AlmLegalizer::findRelaxedScanlineInitialCandidate(
+    const CellState& cell) const
+{
+  std::vector<Candidate> candidates;
+  candidates.reserve(params_.stage1_candidate_cap);
+
+  const int max_y = std::max(core_.ly, core_.uy - cell.h);
+  const int max_x = std::max(core_.lx, core_.ux - cell.w);
+  const int target_y = clampValue(cell.orig_y, core_.ly, max_y);
+  const int target_x = clampValue(cell.orig_x, core_.lx, max_x);
+  const int row_window = 8;
+  const int x_window = 160;
+
+  for (int row_delta = 0; row_delta <= row_window; ++row_delta) {
+    for (int row_sign : {0, -1, 1}) {
+      if ((row_sign == 0) != (row_delta == 0)) {
+        continue;
+      }
+      const int cand_y = target_y + row_sign * row_delta * cell.vertical_step;
+      if (cand_y < core_.ly || cand_y > max_y
+          || !satisfiesRailAlignment(cell, cand_y)) {
+        continue;
+      }
+
+      for (int x_delta = 0; x_delta <= x_window; ++x_delta) {
+        for (int x_sign : {0, -1, 1}) {
+          if ((x_sign == 0) != (x_delta == 0)) {
+            continue;
+          }
+          addRelaxedScanlineCandidate(cell,
+                                      clampValue(target_x + x_sign * x_delta,
+                                                 core_.lx,
+                                                 max_x),
+                                      cand_y,
+                                      candidates);
+          if (static_cast<int>(candidates.size()) >= params_.stage1_candidate_cap) {
+            ++stage1_candidate_cap_hits_;
+            break;
+          }
+        }
+        if (static_cast<int>(candidates.size()) >= params_.stage1_candidate_cap) {
+          break;
+        }
+      }
+      if (static_cast<int>(candidates.size()) >= params_.stage1_candidate_cap) {
+        break;
+      }
+    }
+  }
+
+  if (candidates.empty() && cell.region.type == RegionType::kFence
+      && cell.region.region_id >= 0) {
+    auto it = region_to_plate_ids_.find(cell.region.region_id);
+    if (it != region_to_plate_ids_.end()) {
+      for (const int plate_id : it->second) {
+        const Plate& plate = all_plates_[plate_id];
+        if (plate.rect.width() < cell.w || plate.rect.height() < cell.h) {
+          continue;
+        }
+        addRelaxedScanlineCandidate(cell,
+                                    clampValue(cell.orig_x,
+                                               plate.rect.lx,
+                                               plate.rect.ux - cell.w),
+                                    clampValue(cell.orig_y,
+                                               plate.rect.ly,
+                                               plate.rect.uy - cell.h),
+                                    candidates);
+      }
+    }
+  }
+
+  Candidate best;
+  for (const Candidate& candidate : candidates) {
+    if (lexicographicallyBetter(candidate, best)) {
+      best = candidate;
+    }
+  }
+  return best;
+}
+
+void AlmLegalizer::addRelaxedScanlineCandidate(
+    const CellState& cell,
+    int cand_x,
+    int cand_y,
+    std::vector<Candidate>& candidates) const
+{
+  const GridRect rect{cand_x, cand_y, cand_x + cell.w, cand_y + cell.h};
+  if (!siteRectIsStaticPlaceable(cell, rect)) {
+    ++stage1_static_rejects_;
+    return;
+  }
+
+  Candidate candidate;
+  candidate.x = cand_x;
+  candidate.y = cand_y;
+  candidate.overflow_sites = estimateOverflowAtCandidate(cell, cand_x, cand_y);
+  candidate.cost = evaluateStage1RelaxedCost(cell,
+                                             cand_x,
+                                             cand_y,
+                                             candidate.overflow_sites);
+  candidate.valid = std::isfinite(candidate.cost);
+  if (candidate.valid) {
+    ++stage1_candidate_count_;
+    candidates.push_back(candidate);
+  }
+}
