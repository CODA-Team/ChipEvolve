+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2026, The OpenROAD Authors
+
+#include "AlmPlates.h"
+
+#include <algorithm>
+#include <queue>
+#include <set>
+#include <tuple>
+
+#include "AlmLegalizer.h"
+
+namespace dpl_evolve {
+namespace {
+
+using GridRect = AlmLegalizer::GridRect;
+using Plate = AlmLegalizer::Plate;
+
+struct Interval
+{
+  int lx;
+  int ux;
+};
+
+std::vector<Interval> mergeIntervals(std::vector<Interval> intervals)
+{
+  if (intervals.empty()) {
+    return {};
+  }
+
+  std::sort(intervals.begin(),
+            intervals.end(),
+            [](const Interval& lhs, const Interval& rhs) {
+              return std::tie(lhs.lx, lhs.ux) < std::tie(rhs.lx, rhs.ux);
+            });
+
+  std::vector<Interval> merged;
+  merged.push_back(intervals.front());
+  for (size_t i = 1; i < intervals.size(); ++i) {
+    if (intervals[i].lx <= merged.back().ux) {
+      merged.back().ux = std::max(merged.back().ux, intervals[i].ux);
+    } else {
+      merged.push_back(intervals[i]);
+    }
+  }
+  return merged;
+}
+
+}  // namespace
+
+std::vector<Plate> AlmPlates::buildExteriorPlatesByScanline(
+    const AlmLegalizer::GridRect& core,
+    const std::vector<Plate>& interior)
+{
+  std::set<int> y_breaks{core.ly, core.uy};
+  for (const Plate& plate : interior) {
+    y_breaks.insert(std::max(core.ly, plate.rect.ly));
+    y_breaks.insert(std::min(core.uy, plate.rect.uy));
+  }
+
+  std::vector<int> ys(y_breaks.begin(), y_breaks.end());
+  std::vector<Plate> slab_rects;
+
+  for (size_t yi = 0; yi + 1 < ys.size(); ++yi) {
+    const int y0 = ys[yi];
+    const int y1 = ys[yi + 1];
+    if (y0 >= y1) {
+      continue;
+    }
+
+    std::vector<Interval> blocked;
+    for (const Plate& plate : interior) {
+      if (plate.rect.uy <= y0 || y1 <= plate.rect.ly) {
+        continue;
+      }
+      const int lx = std::max(core.lx, plate.rect.lx);
+      const int ux = std::min(core.ux, plate.rect.ux);
+      if (lx < ux) {
+        blocked.push_back({lx, ux});
+      }
+    }
+
+    const auto merged = mergeIntervals(std::move(blocked));
+    int cursor = core.lx;
+    for (const auto& interval : merged) {
+      if (cursor < interval.lx) {
+        slab_rects.push_back(Plate{
+            AlmLegalizer::GridRect{cursor, y0, interval.lx, y1},
+            false,
+            AlmLegalizer::RegionType::kNone,
+            -1,
+            -1});
+      }
+      cursor = std::max(cursor, interval.ux);
+    }
+    if (cursor < core.ux) {
+      slab_rects.push_back(Plate{
+          AlmLegalizer::GridRect{cursor, y0, core.ux, y1},
+          false,
+          AlmLegalizer::RegionType::kNone,
+          -1,
+          -1});
+    }
+  }
+
+  std::sort(slab_rects.begin(),
+            slab_rects.end(),
+            [](const Plate& lhs, const Plate& rhs) {
+              return std::tie(lhs.rect.lx, lhs.rect.ux, lhs.rect.ly, lhs.rect.uy)
+                     < std::tie(rhs.rect.lx, rhs.rect.ux, rhs.rect.ly, rhs.rect.uy);
+            });
+
+  std::vector<Plate> merged;
+  for (const Plate& plate : slab_rects) {
+    if (!merged.empty()) {
+      Plate& last = merged.back();
+      if (last.rect.lx == plate.rect.lx && last.rect.ux == plate.rect.ux
+          && last.rect.uy == plate.rect.ly && sameSemantics(last, plate)) {
+        last.rect.uy = plate.rect.uy;
+        continue;
+      }
+    }
+    merged.push_back(plate);
+  }
+  return merged;
+}
+
+AlmPlates::Connectivity AlmPlates::buildConnectivity(std::vector<Plate>* plates)
+{
+  Connectivity connectivity;
+  if (plates == nullptr) {
+    return connectivity;
+  }
+
+  auto& local_plates = *plates;
+  const int plate_count = static_cast<int>(local_plates.size());
+  std::vector<int> component(plate_count, -1);
+
+  int next_component = 0;
+  for (int seed = 0; seed < plate_count; ++seed) {
+    if (component[seed] != -1) {
+      continue;
+    }
+
+    std::queue<int> worklist;
+    worklist.push(seed);
+    component[seed] = next_component;
+
+    while (!worklist.empty()) {
+      const int current = worklist.front();
+      worklist.pop();
+
+      for (int candidate = 0; candidate < plate_count; ++candidate) {
+        if (component[candidate] != -1) {
+          continue;
+        }
+        if (!sameSemantics(local_plates[current], local_plates[candidate])) {
+          continue;
+        }
+        if (!edgeAdjacent(local_plates[current].rect,
+                          local_plates[candidate].rect)) {
+          continue;
+        }
+        component[candidate] = next_component;
+        worklist.push(candidate);
+      }
+    }
+
+    ++next_component;
+  }
+
+  for (int i = 0; i < plate_count; ++i) {
+    local_plates[i].component_id = component[i];
+    connectivity.component_to_plate_ids[component[i]].push_back(i);
+    connectivity.component_area_sites[component[i]] += local_plates[i].areaSites();
+  }
+
+  return connectivity;
+}
+
+bool AlmPlates::sameSemantics(const Plate& a, const Plate& b)
+{
+  return a.is_blockage == b.is_blockage && a.region_type == b.region_type
+         && a.region_id == b.region_id;
+}
+
+bool AlmPlates::edgeAdjacent(const GridRect& a, const GridRect& b)
+{
+  if ((a.ux == b.lx || b.ux == a.lx)
+      && std::max(a.ly, b.ly) < std::min(a.uy, b.uy)) {
+    return true;
+  }
+  if ((a.uy == b.ly || b.uy == a.ly)
+      && std::max(a.lx, b.lx) < std::min(a.ux, b.ux)) {
+    return true;
+  }
+  return false;
+}
