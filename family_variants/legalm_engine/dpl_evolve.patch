+#include "AlmPartitioner.h"
+
+#include <algorithm>
+#include <tuple>
+
+#include "AlmLegalizer.h"
+
+namespace dpl_evolve {
+namespace {
+
+using GridRect = AlmLegalizer::GridRect;
+using CellState = AlmLegalizer::CellState;
+using Partition = AlmLegalizer::Partition;
+using PartitionScheme = AlmLegalizer::PartitionScheme;
+
+std::vector<GridRect> generateTiledRects(const GridRect& core,
+                                         int x_step,
+                                         int y_step,
+                                         int x_shift,
+                                         int y_shift)
+{
+  std::vector<GridRect> rects;
+  const int x_origin = core.lx - x_shift;
+  const int y_origin = core.ly - y_shift;
+
+  for (int y = y_origin; y < core.uy; y += y_step) {
+    const int ly = std::max(core.ly, y);
+    const int uy = std::min(core.uy, y + y_step);
+    if (ly >= uy) {
+      continue;
+    }
+    for (int x = x_origin; x < core.ux; x += x_step) {
+      const int lx = std::max(core.lx, x);
+      const int ux = std::min(core.ux, x + x_step);
+      if (lx < ux) {
+        rects.push_back(GridRect{lx, ly, ux, uy});
+      }
+    }
+  }
+  return rects;
+}
+
+}  // namespace
+
+std::vector<PartitionScheme> AlmPartitioner::buildTriplefoldSchemes(
+    const GridRect& core,
+    const std::vector<CellState>& cells,
+    int x_hint_sites,
+    int y_hint_rows)
+{
+  const int x_step = std::max(1, x_hint_sites);
+  const int y_step = std::max(1, y_hint_rows);
+
+  std::vector<PartitionScheme> schemes;
+  schemes.push_back(buildScheme(
+      core, cells, x_step, y_step, 0, 0, "legalm_tp_scheme_0_origin"));
+  schemes.push_back(buildScheme(core,
+                                cells,
+                                x_step,
+                                y_step,
+                                x_step / 3,
+                                y_step / 3,
+                                "legalm_tp_scheme_1_diag_third"));
+  schemes.push_back(buildScheme(core,
+                                cells,
+                                x_step,
+                                y_step,
+                                (2 * x_step) / 3,
+                                (2 * y_step) / 3,
+                                "legalm_tp_scheme_2_diag_two_thirds"));
+  return schemes;
+}
+
+PartitionScheme AlmPartitioner::buildScheme(const GridRect& core,
+                                            const std::vector<CellState>& cells,
+                                            int x_step,
+                                            int y_step,
+                                            int x_shift,
+                                            int y_shift,
+                                            const char* name)
+{
+  PartitionScheme scheme;
+  scheme.name = name;
+
+  const auto rects = generateTiledRects(core, x_step, y_step, x_shift, y_shift);
+  scheme.parts.reserve(rects.size());
+  for (const auto& rect : rects) {
+    scheme.parts.push_back(Partition{rect, {}});
+  }
+
+  for (int cell_id = 0; cell_id < static_cast<int>(cells.size()); ++cell_id) {
+    const auto cell_rect = cells[cell_id].rect();
+    bool assigned = false;
+    for (auto& part : scheme.parts) {
+      if (fullyContained(part.bbox, cell_rect)) {
+        part.cell_ids.push_back(cell_id);
+        assigned = true;
+        break;
+      }
+    }
+
+    if (!assigned) {
+      const int anchor_x = cell_rect.lx + (cell_rect.width() / 2);
+      const int anchor_y = cell_rect.ly + (cell_rect.height() / 2);
+      for (auto& part : scheme.parts) {
+        if (containsAnchor(part.bbox, anchor_x, anchor_y)) {
+          part.cell_ids.push_back(cell_id);
+          assigned = true;
+          break;
+        }
+      }
+    }
+
+    if (!assigned && !scheme.parts.empty()) {
+      auto it = std::min_element(
+          scheme.parts.begin(),
+          scheme.parts.end(),
+          [&](const Partition& lhs, const Partition& rhs) {
+            const int lhs_dx = std::max(
+                {lhs.bbox.lx - cell_rect.lx, 0, cell_rect.ux - lhs.bbox.ux});
+            const int rhs_dx = std::max(
+                {rhs.bbox.lx - cell_rect.lx, 0, cell_rect.ux - rhs.bbox.ux});
+            const int lhs_dy = std::max(
+                {lhs.bbox.ly - cell_rect.ly, 0, cell_rect.uy - lhs.bbox.uy});
+            const int rhs_dy = std::max(
+                {rhs.bbox.ly - cell_rect.ly, 0, cell_rect.uy - rhs.bbox.uy});
+            return std::tie(lhs_dx, lhs_dy, lhs.bbox.ly, lhs.bbox.lx)
+                   < std::tie(rhs_dx, rhs_dy, rhs.bbox.ly, rhs.bbox.lx);
+          });
+      it->cell_ids.push_back(cell_id);
+    }
+  }
+
+  std::sort(scheme.parts.begin(),
+            scheme.parts.end(),
+            [](const Partition& lhs, const Partition& rhs) {
+              return std::tie(lhs.bbox.ly, lhs.bbox.lx, lhs.bbox.uy, lhs.bbox.ux)
+                     < std::tie(rhs.bbox.ly, rhs.bbox.lx, rhs.bbox.uy, rhs.bbox.ux);
+            });
+  return scheme;
+}
+
+bool AlmPartitioner::fullyContained(const GridRect& outer, const GridRect& inner)
+{
+  return outer.contains(inner);
+}
+
+bool AlmPartitioner::containsAnchor(const GridRect& outer, int x, int y)
+{
+  return outer.contains(x, y);
+}
