+bool NegotiationLegalizer::shouldTryPriorityEscape(int cell_idx,
+                                                   int iter,
+                                                   double best_cost,
+                                                   int best_x,
+                                                   int best_y) const
+{
+  if (iter < kIsolationPt) {
+    return false;
+  }
+  const NegCell& cell = cells_[cell_idx];
+  if (best_cost == static_cast<double>(kInfCost)) {
+    return true;
+  }
+  const bool stuck_at_current = best_x == cell.x && best_y == cell.y;
+  if (!stuck_at_current) {
+    return false;
+  }
+  const int best_disp = std::abs(best_x - cell.init_x)
+                        + std::abs(best_y - cell.init_y);
+  return cell.displacement() > 0 || best_disp > 0
+         || iter >= std::max(1, max_iter_neg_ / 4);
+}
