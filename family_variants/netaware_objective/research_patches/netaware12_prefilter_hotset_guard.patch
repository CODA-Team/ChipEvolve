+bool NegotiationLegalizer::netAwareEligible(int cell_idx, int iter) const
+{
+  if (cell_idx < 0 || cell_idx >= static_cast<int>(cell_nets_.size())) {
+    return false;
+  }
+  const auto& nets = cell_nets_[cell_idx];
+  if (nets.empty()) {
+    return false;
+  }
+
+  const NegCell& cell = cells_[cell_idx];
+  const bool large_design = cells_.size() > 100000;
+  const int low_fanout_cap = large_design ? 8 : 16;
+  int low_mid_nets = 0;
+  for (odb::dbNet* net : nets) {
+    if (net == nullptr) {
+      continue;
+    }
+    const int fanout = static_cast<int>(net->getITerms().size());
+    if (fanout > 1 && fanout <= low_fanout_cap) {
+      ++low_mid_nets;
+    }
+  }
+
+  const bool low_mid_fanout_cell = low_mid_nets >= (large_design ? 1 : 2);
+  const int hot_threshold = std::max(2, max_disp_threshold_ / 2);
+  const bool hot_displacement = cell.displacement() >= hot_threshold;
+  const bool late_unsettled
+      = !cell.legal && iter >= std::max(1, max_iter_neg_ / 3);
+  return low_mid_fanout_cell || hot_displacement || late_unsettled;
+}
