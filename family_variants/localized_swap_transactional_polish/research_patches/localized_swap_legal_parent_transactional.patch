+void NegotiationLegalizer::reportLocalizedSwapStats(
+    const LocalizedSwapStats& stats) const
+{
+  logger_->metric("localized_swap_transactional__parent_violations",
+                  stats.parent_violations);
+  logger_->metric("localized_swap_transactional__post_violations",
+                  stats.post_violations);
+  logger_->metric("localized_swap_transactional__attempted_pairs",
+                  stats.attempted_pairs);
+  logger_->metric("localized_swap_transactional__accepted_swaps",
+                  stats.accepted_swaps);
+  logger_->metric("localized_swap_transactional__rollback_count",
+                  stats.rollback_count);
+  logger_->metric("localized_swap_transactional__pair_cap_hit",
+                  stats.pair_cap_hit ? 1 : 0);
+  logger_->metric("localized_swap_transactional__elapsed_ms", stats.elapsed_ms);
+  logger_->report("localized_swap_transactional: skip_reason={} parent={} "
+                  "post={} attempted={} accepted={} rollback={} cap_hit={} "
+                  "elapsed_ms={:.1f}",
+                  stats.skip_reason,
+                  stats.parent_violations,
+                  stats.post_violations,
+                  stats.attempted_pairs,
+                  stats.accepted_swaps,
+                  stats.rollback_count,
+                  stats.pair_cap_hit ? 1 : 0,
