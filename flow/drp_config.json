{
  "drp_settings": {
    "num_kill": 2,
    "description": "Number of runs to kill and replace at each DRP stage (elitist selection only)"
  },
  "gwtw": {
    "beta": 2.0,
    "n_elite": 1,
    "seed": null,
    "clean_identity_quota": 10,
    "description": "GWTW (Go With The Winners) selection. beta = Boltzmann temperature (higher = greedier, approaches elitist truncation; lower = more exploratory). n_elite = top runs guaranteed to survive each stage. clean_identity_quota preserves this many original candidate identities through both DRP checkpoints so final full-flow observations stay attributable. seed = resampling RNG seed (null = nondeterministic)."
  },
  "objectives": ["wl", "ecp", "combo", "TNS_EVAL"],
  "pdk_profiles": {
    "asap7": {
      "process": "ASAP7 academic predictive 7 nm platform",
      "standard_cell_site": "asap7sc7p5t",
      "routing_layer_range": ["M2", "M7"],
      "implementation_characteristics": [
        "tight placement and pin-access geometry",
        "routing capacity and layer adjustments can strongly affect congestion and timing",
        "CTS clustering should be chosen from the observed placement and clock-sink distribution"
      ]
    },
    "nangate45": {
      "process": "Nangate Open Cell Library 45 nm platform",
      "standard_cell_site": "FreePDK45_38x28_10R_NP_162NW_34O",
      "routing_layer_range": ["metal2", "metal10"],
      "implementation_characteristics": [
        "larger physical geometry than ASAP7",
        "placement density, padding, and routing capacity jointly affect routability",
        "upper-layer capacity can mitigate global-routing detours and congestion"
      ]
    }
  },
  "design_profiles": {
    "aes": {
      "rtl_top": "aes_cipher_top",
      "workload": "AES encryption core",
      "implementation_characteristics": [
        "regular cryptographic datapath with control logic",
        "timing and routability are sensitive to utilization, padding, and placement density"
      ]
    },
    "ibex": {
      "rtl_top": "ibex_core",
      "workload": "32-bit RISC-V processor core",
      "implementation_characteristics": [
        "control- and sequential-logic-heavy design",
        "clock-sink distribution and high-fanout control paths make placement-aware CTS important"
      ]
    },
    "jpeg": {
      "rtl_top": "jpeg_encoder",
      "workload": "JPEG encoder",
      "implementation_characteristics": [
        "wide arithmetic and data-movement paths",
        "placement density and routing detours can dominate final timing"
      ]
    },
    "swerv_wrapper": {
      "workload": "RISC-V processor wrapper",
      "implementation_characteristics": [
        "large hierarchical control and datapath logic",
        "high fanout and routing pressure require conservative feasibility-aware tuning"
      ]
    }
  },
  "default_weights": {
    "wl": 0.5,
    "ecp": 0.5
  },
  "power_budget": 0.00,
  "power_budget_description": "For objective=TNS_EVAL: fraction of extra CP_0 power allowed vs baseline(run_1) at CP_0 (0.02 = +2%). Applied exactly to the FINAL objective and inter-iteration optimizer: power-infeasible runs get a large penalty, and missing power is infeasible. Without -P, intermediate DRP ranks by stage |TNS| because CP_0 power is measured only at final. With -P, intermediate DRP instead uses the model's learned relative TNS/power probabilities; its power tolerance is defined by the checkpoint's training labels and is not changed by this setting. null = final constraint off (pure |TNS|).",
  "predictor": {
    "rank_mode": "promising",
    "rank_mode_description": "With -P, rank by promising_cost=1-promising_score (ascending). Set to 'kill' only for an explicit ablation that ranks by kill_score (ascending). Without -P, DRP continues to rank by the stage objective."
  },
  "predictor_baseline_mode": "best",
  "predictor_baseline_mode_description": "Reference trajectory for the QoR-comparator (-P). 'default' = fixed run_1 (baseline config) trajectory saved at iter1. 'best' = the best full-survivor run's trajectory so far (updated each iteration; restores discrimination once runs beat the default). Only survivors are eligible (victim trajectories are chimeras).",
  "llm": {
    "model": "gpt-5.6-sol",
    "base_url": "OPENAI_BASE_URL",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.7,
    "max_tokens": 8192,
    "timeout": 1200
  },
  "supervisor": {
    "model": "gpt-5.6-sol",
    "base_url": "OPENAI_BASE_URL",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.2,
    "max_tokens": 4096,
    "timeout": 600,
    "description": "Separate critic model for Agent2 (Textual Gradient Critic). Swappable to a faster model (e.g. Qwen2.5-72B-Instruct) to cut iteration latency."
  },
  "agentic": {
    "react_max_iters": 2,
    "candidate_pool_mult": 2,
    "lhs_pool_mult": 8,
    "description": "Agent1 ReAct loop max iterations; Agent3 hybrid candidate pool = DRP-generated (candidate_pool_mult x num_runs, keeps elitism/penalty/annealing) UNION LHS-sampled (lhs_pool_mult x num_runs), GPR-scored then agglomeratively selected."
  },
  "search_policy": {
    "enabled": true,
    "objectives": ["TNS_EVAL"],
    "defaults": {
      "min_full_iterations": 5,
      "full_stagnation_patience": 3,
      "reopen_min_full_iterations": 2,
      "focus_min_iterations": 4,
      "focus_stop_patience": 4,
      "min_iterations_before_stop": 25,
      "reopen_low_coverage_patience": 2,
      "significant_improvement_abs": 5.0,
      "significant_improvement_rel": 0.0005,
      "min_clean_count": 5,
      "min_clean_fraction": 0.2,
      "routing_focus_fraction": 0.75,
      "exact_replay_fraction": 0.15,
      "full_probe_fraction": 0.1,
      "full_probe_min_count": 5,
      "anchor_count": 3,
      "routing_jitter_fraction": 0.08,
      "routing_novelty_fraction": 0.25,
      "routing_agentic_target_fraction": 0.65,
      "routing_agentic_family_cap": 0.6,
      "routing_agentic_diversity_weight": 0.2,
      "routing_candidate_pool_per_anchor": 128,
      "routing_model_min_total_observations": 12,
      "routing_model_min_family_observations": 4,
      "routing_model_full_confidence_observations": 8,
      "routing_model_min_cv_improvement": 0.05,
      "routing_acquisition": "ei",
      "routing_trust_min_fraction": 0.02,
      "routing_trust_max_fraction": 0.15,
      "routing_trust_expand_factor": 1.25,
      "routing_trust_shrink_factor": 0.5,
      "front_elite_count": 2,
      "pending_replay_limit": 12,
      "signature_decimals": 6,
      "config_replay_required_successes": 2,
      "config_replay_max_attempts": 3,
      "config_replay_abs_tolerance": 100.0,
      "config_replay_rel_tolerance": 0.01,
      "clock_top_k": 10,
      "clock_min_observations": 5,
      "clock_margin_fraction": 0.1,
      "clock_min_width_fraction": 0.08,
      "clock_region_fraction": 0.8,
      "clock_jitter_fraction": 0.04,
      "cts_tns_100_fraction": 0.0,
      "cts_local_window_fraction": 0.5
    },
    "design_overrides": {
      "asap7/aes": {
        "enabled": false,
        "calibration_status": "pending"
      },
      "asap7/ibex": {
        "enabled": false,
        "calibration_status": "pending"
      },
      "asap7/jpeg": {
        "enabled": false,
        "calibration_status": "pending"
      }
    },
    "description": "Shared plain/agentic defaults with exact per-design activation. AES uses calibrated CTS windows; pending designs retain the generic optimizer until calibrated overrides are enabled. See ROUTING_FOCUS.md."
  },
  "parameter_constraints": {
    "synthesis": {
      "SYNTH_FLATTEN": {
        "type": "int",
        "range": [0, 1],
        "description": "Enables hierarchy flattening during synthesis"
      }
    },
    "placement": {
      "CORE_UTILIZATION": {
        "type": "int",
        "range": [20, 99],
        "description": "Core utilization percentage"
      },
      "CELL_PAD_IN_SITES_GLOBAL_PLACEMENT": {
        "type": "int",
        "range": [0, 3],
        "description": "Cell padding for global placement"
      },
      "CELL_PAD_IN_SITES_DETAIL_PLACEMENT": {
        "type": "int",
        "range": [0, 3],
        "description": "Cell padding for detail placement"
      },
      "ENABLE_DPO": {
        "type": "int",
        "range": [0, 1],
        "description": "Enable detail placement optimization"
      },
      "PLACE_DENSITY_LB_ADDON": {
        "type": "float",
        "range": [0.0, 0.99],
        "description": "Lower bound density addon for placement"
      },
      "TNS_END_PERCENT": {
        "type": "int",
        "range": [0, 100],
        "description": "Percent of violating paths to fix in placement timing repair"
      },
      "FLOORPLAN_PIN_LAYER_ADJUST": {
        "type": "float",
        "range": [0.2, 0.7],
        "description": "Pin-layer resource adjustment fixed before placement"
      },
      "FLOORPLAN_ABOVE_LAYER_ADJUST": {
        "type": "float",
        "range": [0.2, 0.7],
        "description": "Upper-layer resource adjustment fixed before placement"
      }
    },
    "cts": {
      "CTS_CLUSTER_SIZE": {
        "type": "int",
        "range": [10, 40],
        "description": "Max number of sinks per CTS cluster"
      },
      "CTS_CLUSTER_DIAMETER": {
        "type": "int",
        "range": [80, 120],
        "description": "Max CTS cluster diameter in microns"
      }
    },
    "routing": {
      "PIN_LAYER_ADJUST": {
        "type": "float",
        "range": [0.2, 0.7],
        "description": "Routing layer resource adjustment percentages (floats) applied to metal2/3 layers"
      },
      "ABOVE_LAYER_ADJUST": {
        "type": "float",
        "range": [0.2, 0.7],
        "description": "Routing layer resource adjustment percentages (floats) applied to metal4 and above"
      }
    }
  },
