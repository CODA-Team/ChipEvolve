{
  "schema_version": 3,
  "plugin_id": "openroad-data",
  "plugin_version": "0.1.0",
  "adapter_entry": ["python3", "./adapter.py"],
  "capabilities": ["design.snapshot", "timing.snapshot", "flow.snapshot", "analysis.report"],
  "supported_arch": ["x86_64", "aarch64", "arm64"],
  "default_timeout_seconds": 3600,
  "artifact_rules": [
    {"kind": "data_snapshot", "required": false},
    {"kind": "extractor_log", "required": true},
    {"kind": "extractor_receipt", "required": true},
    {"kind": "raw_timing_report", "patterns": ["query-data/timing_report.json"]},
    {"kind": "raw_dbnetwork_map", "patterns": ["query-data/dbnetwork_map.json"]},
    {"kind": "raw_design_database"},
    {"kind": "raw_technology"},
    {"kind": "raw_layout"},
    {"kind": "raw_netlist"},
    {"kind": "raw_library"},
    {"kind": "raw_constraints"},
    {"kind": "raw_parasitics"},
    {"kind": "raw_flow_metadata"},
    {"kind": "analysis_report"},
    {"kind": "analysis_script"},
    {"kind": "analysis_result"}
  ],
  "progress_marker": "[progress]",
  "environment": {}
}
