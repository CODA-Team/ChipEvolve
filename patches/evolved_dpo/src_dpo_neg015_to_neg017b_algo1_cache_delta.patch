+Algo1CachedEdge buildAlgo1CachedEdge(const Edge* edge, const Node* src)
+{
+  Algo1CachedEdge cached;
+  cached.edge = edge;
+  if (edge == nullptr || edge->getNumPins() <= 1) {
+    return cached;
+  }
+  cached.pins.reserve(edge->getNumPins());
+
+  DbuX current_xmin = std::numeric_limits<DbuX>::max();
+  DbuX current_xmax = std::numeric_limits<DbuX>::min();
+  DbuY current_ymin = std::numeric_limits<DbuY>::max();
+  DbuY current_ymax = std::numeric_limits<DbuY>::min();
+
+  DbuX src_outside_xmin = std::numeric_limits<DbuX>::max();
+  DbuX src_outside_xmax = std::numeric_limits<DbuX>::min();
+  DbuY src_outside_ymin = std::numeric_limits<DbuY>::max();
+  DbuY src_outside_ymax = std::numeric_limits<DbuY>::min();
+
+  for (int pi = 0; pi < edge->getNumPins(); ++pi) {
+    const Pin* pin = edge->getPins()[pi];
+    const Node* node = pin->getNode();
+    cached.pins.push_back({node, pin->getOffsetX(), pin->getOffsetY()});
+    const DbuX x = node->getCenterX() + pin->getOffsetX();
+    const DbuY y = node->getCenterY() + pin->getOffsetY();
+    current_xmin = std::min(current_xmin, x);
+    current_xmax = std::max(current_xmax, x);
+    current_ymin = std::min(current_ymin, y);
+    current_ymax = std::max(current_ymax, y);
+    if (node == src) {
+      cached.src_pin_indices.push_back(pi);
+    } else {
+      cached.has_src_outside_pin = true;
+      src_outside_xmin = std::min(src_outside_xmin, x);
+      src_outside_xmax = std::max(src_outside_xmax, x);
+      src_outside_ymin = std::min(src_outside_ymin, y);
+      src_outside_ymax = std::max(src_outside_ymax, y);
+    }
+  }
+
+  cached.current_hpwl = static_cast<double>(
+      (current_xmax - current_xmin).v + (current_ymax - current_ymin).v);
+  if (cached.has_src_outside_pin) {
+    cached.src_outside_xmin = src_outside_xmin;
+    cached.src_outside_xmax = src_outside_xmax;
+    cached.src_outside_ymin = src_outside_ymin;
+    cached.src_outside_ymax = src_outside_ymax;
+  }
+  return cached;
+}
+
+void prepareAlgo1DryRunBatchCache(const Node* src,
+                                  Algo1DryRunBatchCache& cache)
+{
+  cache = Algo1DryRunBatchCache{};
+  cache.src = src;
+  if (src == nullptr) {
+    return;
+  }
+
+  cache.src_edge_index_by_id.reserve(src->getNumPins());
+  for (int pi = 0; pi < src->getNumPins(); ++pi) {
+    const Edge* edge = src->getPins()[pi]->getEdge();
+    if (edge == nullptr || edge->getNumPins() <= 1) {
+      continue;
+    }
+    const int edge_id = edge->getId();
+    if (cache.src_edge_index_by_id.find(edge_id)
+        != cache.src_edge_index_by_id.end()) {
+      continue;
+    }
+    const int edge_index = static_cast<int>(cache.src_edges.size());
+    cache.src_edge_index_by_id[edge_id] = edge_index;
+    cache.src_edges.push_back(buildAlgo1CachedEdge(edge, src));
+    ++cache.cache_misses;
+  }
+}
+
+double cachedEdgeHpwlAfterAlgo1Swap(const Algo1CachedEdge& edge,
+                                    const Node* src,
+                                    const Node* dst,
+                                    const bool dst_on_edge)
+{
+  DbuX xmin = std::numeric_limits<DbuX>::max();
+  DbuX xmax = std::numeric_limits<DbuX>::min();
+  DbuY ymin = std::numeric_limits<DbuY>::max();
+  DbuY ymax = std::numeric_limits<DbuY>::min();
+
+  const DbuX src_center_x_after = nodeCenterXAt(src, dst->getLeft());
+  const DbuY src_center_y_after = nodeCenterYAt(src, dst->getBottom());
+  if (!dst_on_edge && edge.has_src_outside_pin) {
+    xmin = edge.src_outside_xmin;
+    xmax = edge.src_outside_xmax;
+    ymin = edge.src_outside_ymin;
+    ymax = edge.src_outside_ymax;
+    for (const int pin_index : edge.src_pin_indices) {
+      const Algo1CachedPin& pin = edge.pins[pin_index];
+      const DbuX x = src_center_x_after + pin.offset_x;
+      const DbuY y = src_center_y_after + pin.offset_y;
+      xmin = std::min(xmin, x);
+      xmax = std::max(xmax, x);
+      ymin = std::min(ymin, y);
+      ymax = std::max(ymax, y);
+    }
+    return static_cast<double>((xmax - xmin).v + (ymax - ymin).v);
+  }
+
+  const DbuX dst_center_x_after = nodeCenterXAt(dst, src->getLeft());
+  const DbuY dst_center_y_after = nodeCenterYAt(dst, src->getBottom());
+  for (const Algo1CachedPin& pin : edge.pins) {
+    DbuX center_x = pin.node->getCenterX();
+    DbuY center_y = pin.node->getCenterY();
+    if (pin.node == src) {
+      center_x = src_center_x_after;
+      center_y = src_center_y_after;
+    } else if (pin.node == dst) {
+      center_x = dst_center_x_after;
+      center_y = dst_center_y_after;
+    }
+    const DbuX x = center_x + pin.offset_x;
+    const DbuY y = center_y + pin.offset_y;
+    xmin = std::min(xmin, x);
+    xmax = std::max(xmax, x);
+    ymin = std::min(ymin, y);
+    ymax = std::max(ymax, y);
+  }
+  return static_cast<double>((xmax - xmin).v + (ymax - ymin).v);
+}
+
+double dryRunSwapGainCached(const Node* src,
+                            const Algo1SwapCandidate& candidate,
+                            const Algo1DryRunBatchCache& cache,
+                            Algo1DryRunScoreStats& stats,
+                            Algo1DryRunThreadScratch& scratch)
+{
+  double before = 0.0;
+  double after = 0.0;
+  const Node* dst = candidate.dst;
+  if (src == nullptr || dst == nullptr) {
+    return -std::numeric_limits<double>::max();
+  }
+  scratch.dst_on_src_edge.assign(cache.src_edges.size(), 0);
+  scratch.dst_only_edge_ids.clear();
+  scratch.dst_only_edges.clear();
+
+  for (int pi = 0; pi < dst->getNumPins(); ++pi) {
+    const Edge* edge = dst->getPins()[pi]->getEdge();
+    if (edge == nullptr || edge->getNumPins() <= 1) {
+      continue;
+    }
+    const int edge_id = edge->getId();
+    const auto src_edge_it = cache.src_edge_index_by_id.find(edge_id);
+    if (src_edge_it != cache.src_edge_index_by_id.end()) {
+      scratch.dst_on_src_edge[src_edge_it->second] = 1;
+      continue;
+    }
+    if (std::find(scratch.dst_only_edge_ids.begin(),
+                  scratch.dst_only_edge_ids.end(),
+                  edge_id)
+        == scratch.dst_only_edge_ids.end()) {
+      scratch.dst_only_edge_ids.push_back(edge_id);
+      scratch.dst_only_edges.push_back(edge);
+    }
+  }
+
+  for (int i = 0; i < static_cast<int>(cache.src_edges.size()); ++i) {
+    const Algo1CachedEdge& edge = cache.src_edges[i];
+    before += edge.current_hpwl;
+    after += cachedEdgeHpwlAfterAlgo1Swap(edge,
+                                          src,
+                                          dst,
+                                          scratch.dst_on_src_edge[i] != 0);
+    ++stats.affected_edges;
+    ++stats.cache_hits;
+  }
+
+  for (const Edge* edge : scratch.dst_only_edges) {
+    before += edgeHpwlCurrent(edge);
+    after += edgeHpwlWithTwoCellsAt(edge,
+                                    src,
+                                    dst->getLeft(),
+                                    dst->getBottom(),
+                                    dst,
+                                    src->getLeft(),
+                                    src->getBottom());
+    ++stats.affected_edges;
+    ++stats.cache_misses;
+  }
+  return before - after;
+}
