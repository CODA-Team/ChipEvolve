+bool lsmcTransactionMeetsFallbackTarget(const double before_hpwl,
+                                        const double current_hpwl,
+                                        const double target_gain)
+{
+  return before_hpwl - current_hpwl >= target_gain;
+}
+
+double lsmcFallbackTargetGain(const int iter,
+                              const int legal_kicks,
+                              const bool high_recovery_opportunity)
+{
+  if (legal_kicks <= 0) {
+    return std::numeric_limits<double>::max();
+  }
+  const double base_gain = high_recovery_opportunity ? 260000.0 : 1800000.0;
+  const double per_kick_gain = high_recovery_opportunity ? 700.0 : 12000.0;
+  const double decay = std::max(0.45, 1.0 - 0.08 * static_cast<double>(iter - 1));
+  return decay * (base_gain + per_kick_gain * static_cast<double>(legal_kicks));
+}
+
+LsmcFallbackDescentStats runStagedLsmcFallbackDescent(
+    DetailedMgr& mgr,
+    Network* network,
+    const int reorder_window,
+    const char* descent_tol,
+    const bool high_recovery_opportunity,
+    const int iter,
+    const int legal_kicks,
+    const double before_hpwl,
+    const double after_dp_hpwl)
+{
+  LsmcFallbackDescentStats stats;
+  stats.fallback_triggered = true;
+  stats.target_gain
+      = lsmcFallbackTargetGain(iter, legal_kicks, high_recovery_opportunity);
+  stats.full_hpwl_before = after_dp_hpwl;
+
+  if (lsmcTransactionMeetsFallbackTarget(
+          before_hpwl, after_dp_hpwl, stats.target_gain)) {
+    stats.fallback_skipped = true;
+    stats.skip_reason = "target_already_met_after_algo2";
+    stats.full_hpwl_after = after_dp_hpwl;
+    return stats;
+  }
+
+  const std::string cheap_script = buildLsmcCheapFallbackScript(descent_tol);
+  const LsmcFallbackStageStats cheap_stats
+      = runLsmcFallbackStage(mgr, network, cheap_script);
+  stats.called = true;
+  stats.cheap_called = true;
+  stats.script += cheap_script;
+  stats.cheap_gain = cheap_stats.gain;
+  stats.cheap_runtime_ms = cheap_stats.runtime_ms;
+  stats.runtime_ms += cheap_stats.runtime_ms;
+
+  double current_hpwl = cheap_stats.hpwl_after;
+  if (lsmcTransactionMeetsFallbackTarget(
+          before_hpwl, current_hpwl, stats.target_gain)) {
+    stats.full_hpwl_after = current_hpwl;
+    stats.full_hpwl_gain = stats.full_hpwl_before - stats.full_hpwl_after;
+    return stats;
+  }
+
+  const std::string reorder_script
+      = buildLsmcReorderFallbackScript(reorder_window, descent_tol, false);
+  const LsmcFallbackStageStats reorder_stats
+      = runLsmcFallbackStage(mgr, network, reorder_script);
+  stats.full_called = true;
+  stats.script += reorder_script;
+  stats.full_gain = reorder_stats.gain;
+  stats.full_runtime_ms = reorder_stats.runtime_ms;
+  stats.runtime_ms += reorder_stats.runtime_ms;
+
+  current_hpwl = reorder_stats.hpwl_after;
+  if (high_recovery_opportunity
+      && !lsmcTransactionMeetsFallbackTarget(
+          before_hpwl, current_hpwl, stats.target_gain)) {
+    const std::string reverse_script
+        = buildLsmcReorderFallbackScript(reorder_window, descent_tol, true);
+    const LsmcFallbackStageStats reverse_stats
+        = runLsmcFallbackStage(mgr, network, reverse_script);
+    stats.reverse_called = true;
+    stats.script += reverse_script;
+    stats.reverse_gain = reverse_stats.gain;
+    stats.reverse_runtime_ms = reverse_stats.runtime_ms;
+    stats.runtime_ms += reverse_stats.runtime_ms;
+    current_hpwl = reverse_stats.hpwl_after;
+  }
+
+  stats.full_hpwl_after = current_hpwl;
+  stats.full_hpwl_gain = stats.full_hpwl_before - stats.full_hpwl_after;
+  return stats;
+}
