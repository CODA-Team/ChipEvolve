+double edgeSetHpwl(const std::set<Edge*>& edges)
+{
+  double cost = 0.0;
+  for (const Edge* edge : edges) {
+    if (edge == nullptr || edge->getNumPins() <= 1) {
+      continue;
+    }
+    DbuX xmin = std::numeric_limits<DbuX>::max();
+    DbuX xmax = std::numeric_limits<DbuX>::min();
+    DbuY ymin = std::numeric_limits<DbuY>::max();
+    DbuY ymax = std::numeric_limits<DbuY>::min();
+    for (int pi = 0; pi < edge->getNumPins(); ++pi) {
+      const Pin* pin = edge->getPins()[pi];
+      const Node* node = pin->getNode();
+      const DbuX x = node->getCenterX() + pin->getOffsetX();
+      const DbuY y = node->getCenterY() + pin->getOffsetY();
+      xmin = std::min(xmin, x);
+      xmax = std::max(xmax, x);
+      ymin = std::min(ymin, y);
+      ymax = std::max(ymax, y);
+    }
+    cost += static_cast<double>((xmax - xmin).v + (ymax - ymin).v);
+  }
+  return cost;
+}
+
+std::vector<const Edge*> collectTwoCellEdges(const Node* src, const Node* dst)
+{
+  std::vector<const Edge*> edges;
+  std::unordered_set<int> seen;
+  for (const Node* node : {src, dst}) {
+    if (node == nullptr) {
+      continue;
+    }
+    for (int pi = 0; pi < node->getNumPins(); ++pi) {
+      const Edge* edge = node->getPins()[pi]->getEdge();
+      if (edge == nullptr || edge->getNumPins() <= 1) {
+        continue;
+      }
+      if (seen.insert(edge->getId()).second) {
+        edges.push_back(edge);
+      }
+    }
+  }
+  return edges;
+}
+
+double edgeHpwlWithTwoCellsAt(const Edge* edge,
+                              const Node* a,
+                              const DbuX a_left,
+                              const DbuY a_bottom,
+                              const Node* b,
+                              const DbuX b_left,
+                              const DbuY b_bottom)
+{
+  DbuX xmin = std::numeric_limits<DbuX>::max();
+  DbuX xmax = std::numeric_limits<DbuX>::min();
+  DbuY ymin = std::numeric_limits<DbuY>::max();
+  DbuY ymax = std::numeric_limits<DbuY>::min();
+  for (int pi = 0; pi < edge->getNumPins(); ++pi) {
+    const Pin* pin = edge->getPins()[pi];
+    const Node* node = pin->getNode();
+    DbuX center_x = node->getCenterX();
+    DbuY center_y = node->getCenterY();
+    if (node == a) {
+      center_x = nodeCenterXAt(node, a_left);
+      center_y = nodeCenterYAt(node, a_bottom);
+    } else if (node == b) {
+      center_x = nodeCenterXAt(node, b_left);
+      center_y = nodeCenterYAt(node, b_bottom);
+    }
+    const DbuX x = center_x + pin->getOffsetX();
+    const DbuY y = center_y + pin->getOffsetY();
+    xmin = std::min(xmin, x);
+    xmax = std::max(xmax, x);
+    ymin = std::min(ymin, y);
+    ymax = std::max(ymax, y);
+  }
+  return static_cast<double>((xmax - xmin).v + (ymax - ymin).v);
+}
+
+double edgeHpwlCurrent(const Edge* edge)
+{
+  DbuX xmin = std::numeric_limits<DbuX>::max();
+  DbuX xmax = std::numeric_limits<DbuX>::min();
+  DbuY ymin = std::numeric_limits<DbuY>::max();
+  DbuY ymax = std::numeric_limits<DbuY>::min();
+  for (int pi = 0; pi < edge->getNumPins(); ++pi) {
+    const Pin* pin = edge->getPins()[pi];
+    const Node* node = pin->getNode();
+    const DbuX x = node->getCenterX() + pin->getOffsetX();
+    const DbuY y = node->getCenterY() + pin->getOffsetY();
+    xmin = std::min(xmin, x);
+    xmax = std::max(xmax, x);
+    ymin = std::min(ymin, y);
+    ymax = std::max(ymax, y);
+  }
+  return static_cast<double>((xmax - xmin).v + (ymax - ymin).v);
+}
+
+double dryRunSwapGain(const Node* src, const Node* dst)
+{
+  double before = 0.0;
+  double after = 0.0;
+  const std::vector<const Edge*> edges = collectTwoCellEdges(src, dst);
+  for (const Edge* edge : edges) {
+    before += edgeHpwlCurrent(edge);
+    after += edgeHpwlWithTwoCellsAt(edge,
+                                    src,
+                                    dst->getLeft(),
+                                    dst->getBottom(),
+                                    dst,
+                                    src->getLeft(),
+                                    src->getBottom());
+  }
+  return before - after;
+}
+
+double journalExactGainWithOriginalOrient(
+    const Journal& journal,
+    const std::unordered_map<int, odb::dbOrientType>& original_orient)
+{
+  const std::vector<JournalMoveState> moves = collectJournalMoves(journal);
+  const double after = edgeSetHpwl(journal.getAffectedEdges());
+
+  std::vector<RuntimeCellState> runtime_states;
+  runtime_states.reserve(moves.size());
+  for (const JournalMoveState& move : moves) {
+    Node* node = move.node;
+    runtime_states.push_back(
+        {node, node->getLeft(), node->getBottom(), node->getOrient()});
+    node->setLeft(move.orig_left);
+    node->setBottom(move.orig_bottom);
+    const auto orient_it = original_orient.find(node->getId());
+    if (orient_it != original_orient.end()) {
+      node->adjustCurrOrient(orient_it->second);
+    }
+  }
+
+  const double before = edgeSetHpwl(journal.getAffectedEdges());
+  for (const RuntimeCellState& state : runtime_states) {
+    state.node->setLeft(state.left);
+    state.node->setBottom(state.bottom);
+    state.node->adjustCurrOrient(state.orient);
+  }
+  return before - after;
+}
+
+LocalDpCostCache prepareLocalDpCostCache(const std::vector<Node*>& cells,
+                                         LocalDpStats& stats)
+{
+  constexpr int kSkipNetsLargerThanThis = 100;
+  LocalDpCostCache cache;
+  cache.cells = cells;
+  cache.cell_index_by_id.reserve(cells.size() * 2);
+  for (int i = 0; i < static_cast<int>(cells.size()); ++i) {
+    cache.cell_index_by_id[cells[i]->getId()] = i;
+  }
+
+  std::unordered_set<int> seen_edges;
+  for (const Node* node : cells) {
+    for (int pi = 0; pi < node->getNumPins(); ++pi) {
+      const Edge* edge = node->getPins()[pi]->getEdge();
+      if (edge == nullptr || edge->getNumPins() <= 1
+          || edge->getNumPins() >= kSkipNetsLargerThanThis) {
+        continue;
+      }
+      if (!seen_edges.insert(edge->getId()).second) {
+        ++stats.cache_hits;
+        continue;
+      }
+
+      ++stats.cache_misses;
+      LocalDpCachedEdge cached;
+      cached.edge = edge;
+      for (int pj = 0; pj < edge->getNumPins(); ++pj) {
+        const Pin* pin = edge->getPins()[pj];
+        const Node* pin_node = pin->getNode();
+        const auto it = cache.cell_index_by_id.find(pin_node->getId());
+        if (it != cache.cell_index_by_id.end()) {
+          cached.inside_pins.push_back({pin, it->second});
+          continue;
+        }
+
+        const DbuX x = pin_node->getCenterX() + pin->getOffsetX();
+        const DbuY y = pin_node->getCenterY() + pin->getOffsetY();
+        if (!cached.has_outside_pin) {
+          cached.outside_xmin = x;
+          cached.outside_xmax = x;
+          cached.outside_ymin = y;
+          cached.outside_ymax = y;
+          cached.has_outside_pin = true;
+        } else {
+          cached.outside_xmin = std::min(cached.outside_xmin, x);
+          cached.outside_xmax = std::max(cached.outside_xmax, x);
+          cached.outside_ymin = std::min(cached.outside_ymin, y);
+          cached.outside_ymax = std::max(cached.outside_ymax, y);
+        }
+      }
+      cache.edges.push_back(std::move(cached));
+    }
+  }
+  stats.cache_edges += cache.edges.size();
+  return cache;
+}
+
+double localDpCostWithChoice(const LocalDpCostCache& cache,
+                             const std::vector<LocalDpSite>& sites,
+                             const LocalDpChoice& choice,
+                             const int assigned_count)
+{
+  double cost = 0.0;
+  for (const LocalDpCachedEdge& cached : cache.edges) {
+    bool initialized = false;
+    DbuX xmin{0};
+    DbuX xmax{0};
+    DbuY ymin{0};
+    DbuY ymax{0};
+    if (cached.has_outside_pin) {
+      xmin = cached.outside_xmin;
+      xmax = cached.outside_xmax;
+      ymin = cached.outside_ymin;
+      ymax = cached.outside_ymax;
+      initialized = true;
+    }
+
+    for (const LocalDpCachedPin& cached_pin : cached.inside_pins) {
+      const Pin* pin = cached_pin.pin;
+      const int cell_index = cached_pin.cell_index;
+      const Node* node = cache.cells[cell_index];
+      DbuX x = node->getCenterX() + pin->getOffsetX();
+      DbuY y = node->getCenterY() + pin->getOffsetY();
+      if (cell_index < assigned_count && choice[cell_index] >= 0) {
+        const LocalDpSite& site = sites[choice[cell_index]];
+        x = nodeCenterXAt(node, site.x) + pin->getOffsetX();
+        y = nodeCenterYAt(node, site.y) + pin->getOffsetY();
+      }
+      if (!initialized) {
+        xmin = x;
+        xmax = x;
+        ymin = y;
+        ymax = y;
+        initialized = true;
+      } else {
+        xmin = std::min(xmin, x);
+        xmax = std::max(xmax, x);
+        ymin = std::min(ymin, y);
+        ymax = std::max(ymax, y);
+      }
+    }
+    if (initialized) {
+      cost += static_cast<double>((xmax - xmin).v + (ymax - ymin).v);
+    }
+  }
+  return cost;
+}
+
+std::vector<LocalDpCellState> captureSelectedCells(
+    DetailedMgr& mgr,
+    const std::vector<Node*>& cells)
+{
+  std::vector<LocalDpCellState> states;
+  states.reserve(cells.size());
+  for (Node* node : cells) {
+    LocalDpCellState state;
+    state.node = node;
+    state.left = node->getLeft();
+    state.bottom = node->getBottom();
+    state.orient = node->getOrient();
+    state.placed = node->isPlaced();
+    for (const DetailedSeg* seg : mgr.getReverseCellToSegs(node->getId())) {
+      if (seg != nullptr) {
+        state.segment_ids.push_back(seg->getSegId());
+      }
+    }
+    states.push_back(std::move(state));
+  }
+  return states;
+}
+
+void removeSelectedFromCurrentSegments(DetailedMgr& mgr,
+                                       const std::vector<Node*>& cells)
+{
+  for (Node* node : cells) {
+    if (node == nullptr || !node->isPlaced()) {
+      continue;
+    }
+    mgr.eraseFromGrid(node);
+    std::vector<int> current_segments;
+    for (const DetailedSeg* seg : mgr.getReverseCellToSegs(node->getId())) {
+      if (seg != nullptr) {
+        current_segments.push_back(seg->getSegId());
+      }
+    }
+    for (const int seg_id : current_segments) {
+      mgr.removeCellFromSegment(node, seg_id);
+    }
+  }
+}
+
+void restoreSelectedCells(DetailedMgr& mgr,
+                          const std::vector<LocalDpCellState>& states)
+{
+  std::vector<Node*> nodes;
+  nodes.reserve(states.size());
+  for (const LocalDpCellState& state : states) {
+    if (state.node != nullptr) {
+      nodes.push_back(state.node);
+    }
+  }
+  removeSelectedFromCurrentSegments(mgr, nodes);
+  for (const LocalDpCellState& state : states) {
+    Node* node = state.node;
+    if (node == nullptr) {
+      continue;
+    }
+    node->setLeft(state.left);
+    node->setBottom(state.bottom);
+    node->setPlaced(state.placed);
+    if (!state.placed) {
+      continue;
+    }
+    mgr.paintInGrid(node);
+    node->adjustCurrOrient(state.orient);
+    for (const int seg_id : state.segment_ids) {
+      mgr.addCellToSegment(node, seg_id);
+    }
+  }
+  mgr.resortSegments();
+}
+
+bool applyLocalDpAssignment(DetailedMgr& mgr,
+                            Architecture* arch,
+                            Network* network,
+                            const std::vector<LocalDpAssignment>& assignment)
+{
+  std::vector<Node*> cells;
+  cells.reserve(assignment.size());
+  for (const LocalDpAssignment& item : assignment) {
+    cells.push_back(item.node);
+  }
+  removeSelectedFromCurrentSegments(mgr, cells);
+
+  DetailedOrient orienter(arch, network);
+  for (const LocalDpAssignment& item : assignment) {
+    Node* node = item.node;
+    node->setLeft(item.x);
+    node->setBottom(item.y);
+    node->setPlaced(true);
+    orienter.orientSingleHeightCellForRow(node, item.row);
+    mgr.paintInGrid(node);
+    mgr.addCellToSegment(node, item.seg);
+  }
+  mgr.resortSegments();
+  for (const LocalDpAssignment& item : assignment) {
+    if (mgr.hasPlacementViolation(item.node)) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool closeRowRightLegal(Architecture* arch,
+                        const Node* cell,
+                        const LocalDpSite& site)
+{
+  if (site.right_external == nullptr) {
+    return site.x + cell->getWidth() <= site.right_limit;
+  }
+  return site.x + cell->getWidth()
+         + DbuX{arch->getCellSpacing(cell, site.right_external)}
+         <= site.right_external->getLeft();
+}
+
+bool firstInRowLeftLegal(Architecture* arch,
+                         const Node* cell,
+                         const LocalDpSite& site)
+{
+  if (site.left_external == nullptr) {
+    return site.x >= arch->getRow(site.row)->getLeft();
+  }
+  return site.left_external->getRight()
+             + DbuX{arch->getCellSpacing(site.left_external, cell)}
+         <= site.x;
+}
+
+bool transitionLegal(Architecture* arch,
+                     const Node* prev_cell,
+                     const LocalDpSite& prev_site,
+                     const Node* cell,
+                     const LocalDpSite& site)
+{
+  if (prev_site.row == site.row) {
+    return prev_site.x + prev_cell->getWidth()
+               + DbuX{arch->getCellSpacing(prev_cell, cell)}
+           <= site.x;
+  }
+  return closeRowRightLegal(arch, prev_cell, prev_site)
+         && firstInRowLeftLegal(arch, cell, site);
+}
+
+bool siteCanHostCell(DetailedMgr& mgr,
+                     Architecture* arch,
+                     const Node* cell,
+                     const LocalDpSite& site)
+{
+  if (cell == nullptr || site.seg < 0 || site.row < 0) {
+    return false;
+  }
+  const DetailedSeg* seg = mgr.getSegment(site.seg);
+  if (cell->getGroupId() != seg->getRegId()) {
+    return false;
+  }
+  if (site.x < seg->getMinX() || site.x + cell->getWidth() > seg->getMaxX()) {
+    return false;
+  }
+  const DbuX dx{std::abs((site.x - cell->getOrigLeft()).v)};
+  const DbuY dy{std::abs((site.y - cell->getOrigBottom()).v)};
+  if (dx > mgr.getMaxDisplacementX() || dy > mgr.getMaxDisplacementY()) {
+    return false;
+  }
+  return arch->isSingleHeightCell(cell);
+}
+
+bool buildLocalDpWindow(DetailedMgr& mgr,
+                        Architecture* arch,
+                        const LsmcKickAnchor& anchor,
+                        const bool high_recovery_opportunity,
+                        std::vector<LocalDpRowScope>& scopes,
+                        std::vector<Node*>& cells,
+                        std::vector<LocalDpSite>& sites)
+{
+  scopes.clear();
+  cells.clear();
+  sites.clear();
+  if (anchor.row < 0 || arch->getNumRows() <= 0) {
+    return false;
+  }
+
+  const int row_radius = 1;  // Paper default m=3, clipped to 2 at boundaries.
+  const int per_row_cells = high_recovery_opportunity ? 3 : 2;
+  const int site_radius = high_recovery_opportunity ? 36 : 28;
+  const DbuX site_width = arch->getRow(0)->getSiteSpacing();
+
+  for (int row = std::max(0, anchor.row - row_radius);
+       row <= std::min(arch->getNumRows() - 1, anchor.row + row_radius);
+       ++row) {
+    int seg_id = -1;
+    for (DetailedSeg* seg : mgr.getSegsInRow(row)) {
+      if (anchor.x >= seg->getMinX() && anchor.x <= seg->getMaxX()) {
+        seg_id = seg->getSegId();
+        break;
+      }
+    }
+    if (seg_id < 0) {
+      continue;
+    }
+    mgr.sortCellsInSeg(seg_id);
+    const std::vector<Node*>& row_cells = mgr.getCellsInSeg(seg_id);
+    if (row_cells.empty()) {
+      continue;
+    }
+
+    int nearest = -1;
+    int nearest_dist = std::numeric_limits<int>::max();
+    for (int i = 0; i < static_cast<int>(row_cells.size()); ++i) {
+      if (!movableSingleHeightCell(arch, row_cells[i])) {
+        continue;
+      }
+      const int dist = std::abs((row_cells[i]->getCenterX() - anchor.x).v);
+      if (dist < nearest_dist) {
+        nearest_dist = dist;
+        nearest = i;
+      }
+    }
+    if (nearest < 0) {
+      continue;
+    }
+
+    int left = nearest;
+    int right = nearest;
+    while (right - left + 1 < per_row_cells) {
+      const bool can_left = left > 0 && movableSingleHeightCell(arch, row_cells[left - 1]);
+      const bool can_right = right + 1 < static_cast<int>(row_cells.size())
+                             && movableSingleHeightCell(arch, row_cells[right + 1]);
+      if (!can_left && !can_right) {
+        break;
+      }
+      if (!can_left) {
+        ++right;
+      } else if (!can_right) {
+        --left;
+      } else {
+        const int left_dist
+            = std::abs((row_cells[left - 1]->getCenterX() - anchor.x).v);
+        const int right_dist
+            = std::abs((row_cells[right + 1]->getCenterX() - anchor.x).v);
+        if (left_dist <= right_dist) {
+          --left;
+        } else {
+          ++right;
+        }
+      }
+    }
+
+    LocalDpRowScope scope;
+    scope.row = row;
+    scope.seg = seg_id;
+    scope.left_external = left > 0 ? row_cells[left - 1] : nullptr;
+    scope.right_external = right + 1 < static_cast<int>(row_cells.size())
+                               ? row_cells[right + 1]
+                               : nullptr;
+    DetailedSeg* seg = mgr.getSegment(seg_id);
+    scope.left_limit = seg->getMinX();
+    scope.right_limit = seg->getMaxX();
+    if (scope.left_external != nullptr) {
+      scope.left_limit = std::max(scope.left_limit,
+                                  scope.left_external->getRight());
+    }
+    if (scope.right_external != nullptr) {
+      scope.right_limit = std::min(scope.right_limit,
+                                   scope.right_external->getLeft());
+    }
+
+    DbuX xmin = row_cells[left]->getLeft();
+    DbuX xmax = row_cells[right]->getRight();
+    const DbuX radius{site_radius * site_width.v};
+    scope.left_limit = std::max(scope.left_limit, xmin - radius);
+    scope.right_limit = std::min(scope.right_limit, xmax + radius);
+    if (scope.right_limit <= scope.left_limit) {
+      continue;
+    }
+
+    for (int i = left; i <= right; ++i) {
+      scope.cells.push_back(row_cells[i]);
+      cells.push_back(row_cells[i]);
+    }
+    scopes.push_back(scope);
+  }
+
+  std::sort(cells.begin(), cells.end(), [](const Node* lhs, const Node* rhs) {
+    if (lhs->getRight() != rhs->getRight()) {
+      return lhs->getRight() < rhs->getRight();
+    }
+    if (lhs->getBottom() != rhs->getBottom()) {
+      return lhs->getBottom() < rhs->getBottom();
+    }
+    return lhs->getId() < rhs->getId();
+  });
+  cells.erase(std::unique(cells.begin(), cells.end()), cells.end());
+  if (cells.size() < 2 || cells.size() > 9) {
+    return false;
+  }
+
+  for (const LocalDpRowScope& scope : scopes) {
+    const Architecture::Row* row = arch->getRow(scope.row);
+    DbuX x = alignSiteCeil(row, scope.left_limit);
+    int emitted = 0;
+    while (x < scope.right_limit && emitted < 64) {
+      LocalDpSite site;
+      site.row = scope.row;
+      site.seg = scope.seg;
+      site.x = x;
+      site.y = row->getBottom();
+      site.left_external = scope.left_external;
+      site.right_external = scope.right_external;
+      site.right_limit = scope.right_limit;
+      sites.push_back(site);
+      x += row->getSiteSpacing();
+      ++emitted;
+    }
+  }
+  std::sort(sites.begin(), sites.end(), [](const LocalDpSite& lhs,
+                                           const LocalDpSite& rhs) {
+    if (lhs.row != rhs.row) {
+      return lhs.row < rhs.row;
+    }
+    if (lhs.x != rhs.x) {
+      return lhs.x < rhs.x;
+    }
+    return lhs.seg < rhs.seg;
+  });
+  return sites.size() >= cells.size();
+}
+
+bool runLocalDpWindow(DetailedMgr& mgr,
+                      Architecture* arch,
+                      Network* network,
+                      const LsmcKickAnchor& anchor,
+                      const bool high_recovery_opportunity,
+                      LocalDpStats& stats)
+{
+  ++stats.windows_considered;
+  std::vector<LocalDpRowScope> scopes;
+  std::vector<Node*> cells;
+  std::vector<LocalDpSite> sites;
+  if (!buildLocalDpWindow(
+          mgr, arch, anchor, high_recovery_opportunity, scopes, cells, sites)) {
+    ++stats.windows_skipped;
+    return false;
+  }
+  ++stats.windows_built;
+  stats.dp_cells += cells.size();
+  stats.dp_sites += sites.size();
+
+  const LocalDpCostCache cost_cache = prepareLocalDpCostCache(cells, stats);
+  if (cost_cache.edges.empty()) {
+    ++stats.rejected_no_dp;
+    return false;
+  }
+  LocalDpChoice empty_choice;
+  empty_choice.fill(-1);
+  const double exact_before
+      = localDpCostWithChoice(cost_cache, sites, empty_choice, 0);
+
+  const int n = static_cast<int>(cells.size());
+  const int m = static_cast<int>(sites.size());
+  constexpr double kInf = std::numeric_limits<double>::max() / 4.0;
+  std::vector<std::vector<double>> dp(n, std::vector<double>(m, kInf));
+  std::vector<std::vector<LocalDpChoice>> choices(
+      n, std::vector<LocalDpChoice>(m, empty_choice));
+
+  std::vector<std::vector<bool>> legal_site(n, std::vector<bool>(m, false));
+  for (int i = 0; i < n; ++i) {
+    for (int j = 0; j < m; ++j) {
+      if (!siteCanHostCell(mgr, arch, cells[i], sites[j])) {
+        ++stats.dp_pruned_states;
+        continue;
+      }
+      legal_site[i][j] = true;
+      ++stats.dryrun_scored;
+    }
+  }
+
+  for (int j = 0; j < m; ++j) {
+    if (!legal_site[0][j] || !firstInRowLeftLegal(arch, cells[0], sites[j])) {
+      ++stats.dp_pruned_states;
+      continue;
+    }
+    LocalDpChoice choice = empty_choice;
+    choice[0] = j;
+    dp[0][j] = localDpCostWithChoice(cost_cache, sites, choice, 1);
+    choices[0][j] = choice;
+    ++stats.exact_scored;
+    ++stats.dp_states;
+  }
+
+  for (int i = 1; i < n; ++i) {
+    for (int j = 0; j < m; ++j) {
+      if (!legal_site[i][j]) {
+        continue;
+      }
+      for (int l = 0; l < j; ++l) {
+        ++stats.dp_transitions;
+        if (dp[i - 1][l] >= kInf) {
+          continue;
+        }
+        if (!transitionLegal(arch, cells[i - 1], sites[l], cells[i], sites[j])) {
+          ++stats.dp_pruned_states;
+          continue;
+        }
+        LocalDpChoice trial_choice = choices[i - 1][l];
+        trial_choice[i] = j;
+        const double trial
+            = localDpCostWithChoice(cost_cache, sites, trial_choice, i + 1);
+        ++stats.exact_scored;
+        if (trial < dp[i][j]) {
+          dp[i][j] = trial;
+          choices[i][j] = trial_choice;
+        }
+      }
+      if (dp[i][j] < kInf) {
+        ++stats.dp_states;
+      }
+    }
+  }
+
+  std::vector<std::pair<double, int>> final_states;
+  final_states.reserve(m);
+  for (int j = 0; j < m; ++j) {
+    if (dp[n - 1][j] < kInf
+        && closeRowRightLegal(arch, cells[n - 1], sites[j])) {
+      final_states.push_back({dp[n - 1][j], j});
+    }
+  }
+  if (final_states.empty()) {
+    ++stats.rejected_no_dp;
+    return false;
+  }
+  std::sort(final_states.begin(), final_states.end());
+
+  const std::vector<LocalDpCellState> snapshot = captureSelectedCells(mgr, cells);
+  const int max_backtracks = std::min<int>(8, final_states.size());
+  for (int candidate = 0; candidate < max_backtracks; ++candidate) {
+    const int best_j = final_states[candidate].second;
+    const LocalDpChoice& site_choice = choices[n - 1][best_j];
+    std::vector<LocalDpAssignment> assignment;
+    assignment.reserve(cells.size());
+    for (int i = 0; i < n; ++i) {
+      const LocalDpSite& site = sites[site_choice[i]];
+      assignment.push_back({cells[i], site.row, site.seg, site.x, site.y});
+    }
+
+    if (!applyLocalDpAssignment(mgr, arch, network, assignment)) {
+      restoreSelectedCells(mgr, snapshot);
+      ++stats.rejected_legal;
+      continue;
+    }
+
+    const double exact_after = localDpCostWithChoice(
+        cost_cache, sites, site_choice, static_cast<int>(cells.size()));
+    const double exact_gain = exact_before - exact_after;
+    if (exact_gain > 0.0) {
+      ++stats.accepted_windows;
+      stats.exact_gain += exact_gain;
+      return true;
+    }
+    restoreSelectedCells(mgr, snapshot);
+  }
+
+  ++stats.rejected_no_exact_gain;
+  return false;
+}
+
+LocalDpStats runAlgo2LocalDpDescent(DetailedMgr& mgr,
+                                    Architecture* arch,
+                                    Network* network,
+                                    const LsmcKickTrace& kick_trace,
+                                    const bool high_recovery_opportunity,
+                                    const int max_windows_override = -1)
+{
+  LocalDpStats stats;
+  stats.kicked_rows = kick_trace.rows.size();
+  stats.kicked_nodes = kick_trace.nodes.size();
+  stats.kick_anchors = kick_trace.anchors.size();
+  const auto start = std::chrono::steady_clock::now();
+  if (kick_trace.anchors.empty()) {
+    return stats;
+  }
+
+  const int max_windows = max_windows_override > 0
+                              ? max_windows_override
+                              : (high_recovery_opportunity ? 160 : 128);
+  const DbuX site_width = arch->getRow(0)->getSiteSpacing();
+  std::set<std::pair<int, int>> seen_windows;
+  int windows = 0;
+  for (const LsmcKickAnchor& anchor : kick_trace.anchors) {
+    if (windows >= max_windows) {
+      break;
+    }
+    const int x_bin = site_width.v > 0 ? anchor.x.v / (site_width.v * 12) : 0;
+    const std::pair<int, int> key{anchor.row, x_bin};
+    if (!seen_windows.insert(key).second) {
+      ++stats.cache_hits;
+      continue;
+    }
+    if (runLocalDpWindow(
+            mgr, arch, network, anchor, high_recovery_opportunity, stats)) {
+      mgr.resortSegments();
+    }
+    ++windows;
+  }
+
+  stats.runtime_ms
+      = std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() - start)
+            .count();
+  return stats;
+}
+
+LsmcKickTrace buildAlgo2SeedTrace(DetailedMgr& mgr,
+                                  Architecture* arch,
+                                  const bool high_recovery_opportunity)
+{
+  LsmcKickTrace trace;
+  const int max_anchors = high_recovery_opportunity ? 768 : 512;
+  const int row_stride = high_recovery_opportunity ? 1 : 2;
+  for (int row = 0; row < arch->getNumRows()
+                    && static_cast<int>(trace.anchors.size()) < max_anchors;
+       row += row_stride) {
+    for (DetailedSeg* seg : mgr.getSegsInRow(row)) {
+      if (static_cast<int>(trace.anchors.size()) >= max_anchors) {
+        break;
+      }
+      const int seg_id = seg->getSegId();
+      mgr.sortCellsInSeg(seg_id);
+      const std::vector<Node*>& cells = mgr.getCellsInSeg(seg_id);
+      if (cells.size() < 4) {
+        continue;
+      }
+      const int samples = high_recovery_opportunity ? 3 : 2;
+      for (int sample = 1; sample <= samples; ++sample) {
+        const int idx = (sample * static_cast<int>(cells.size()))
+                        / (samples + 1);
+        Node* node = cells[std::clamp(idx, 0, static_cast<int>(cells.size()) - 1)];
+        if (!movableSingleHeightCell(arch, node)) {
+          continue;
+        }
+        addKickAnchor(arch, trace, node, node->getLeft(), node->getBottom());
+        if (static_cast<int>(trace.anchors.size()) >= max_anchors) {
+          break;
+        }
+      }
+    }
+  }
+  return trace;
+}
+
+std::string buildLsmc003FallbackScript(const int reorder_window,
+                                       const char* descent_tol,
+                                       const bool high_recovery_opportunity)
+{
+  std::string descent_script;
+  descent_script += fmt::format("gs -p 1 -t {};", descent_tol);
+  descent_script += fmt::format("vs -p 1 -t {};", descent_tol);
+  descent_script += fmt::format(
+      "ro -w {} -p 1 -t {};", reorder_window, descent_tol);
+  if (high_recovery_opportunity) {
+    descent_script += fmt::format(
+        "ro -w {} -p 1 -t {} -reverse;", reorder_window, descent_tol);
+  }
+  return descent_script;
+}
+
+LsmcFallbackDescentStats runLsmc003FallbackDescent(
+    DetailedMgr& mgr,
+    Network* network,
+    const int reorder_window,
+    const char* descent_tol,
+    const bool high_recovery_opportunity)
+{
+  LsmcFallbackDescentStats stats;
+  stats.called = true;
+  stats.script = buildLsmc003FallbackScript(
+      reorder_window, descent_tol, high_recovery_opportunity);
+  stats.full_hpwl_before = currentHpwl(network);
+  const auto start = std::chrono::steady_clock::now();
+
+  DetailedParams descent_params;
+  descent_params.script = stats.script;
+  Detailed descent(descent_params);
+  descent.improve(mgr);
+
+  stats.full_hpwl_after = currentHpwl(network);
+  stats.full_hpwl_gain = stats.full_hpwl_before - stats.full_hpwl_after;
+  stats.runtime_ms
+      = std::chrono::duration<double, std::milli>(
+            std::chrono::steady_clock::now() - start)
+            .count();
+  return stats;
+}
+
+bool generateAlgo1RegionKickSwap(DetailedMgr& mgr,
+                                  Architecture* arch,
+                                  std::vector<Node*>& candidates,
+                                  const bool high_recovery_opportunity,
+                                  LsmcKickTrace& kick_trace)
+{
+  if (arch == nullptr || candidates.empty()) {
+    return false;
+  }
+
+  const DbuX site_width = arch->getRow(0)->getSiteSpacing();
+  constexpr int kCandidateTries = 8;
+  constexpr int kNeighborCellsPerSegment = 18;
+  constexpr int kMaxExactCandidates = 12;
+  const DbuX region_padding{site_width.v
+                            * (high_recovery_opportunity ? 96 : 64)};
+  const DbuX max_swap_distance{site_width.v * 1024};  // About 200um on NG45.
+  const int row_radius = high_recovery_opportunity ? 4 : 3;
+#ifdef _OPENMP
+  const int worker_count = boundedThreadCount();
+#endif
+
+  for (int attempt = 0; attempt < kCandidateTries; ++attempt) {
+    Node* src = candidates[mgr.getRandom(candidates.size())];
+    if (!movableSingleHeightCell(arch, src)) {
+      continue;
+    }
+    const std::vector<DetailedSeg*>& src_segs
+        = mgr.getReverseCellToSegs(src->getId());
+    if (src_segs.size() != 1) {
+      continue;
+    }
+    const int src_seg = src_segs[0]->getSegId();
+
+    Algo1OptimalRegion region;
+    ++kick_trace.kick_region_attempts;
+    if (!computeAlgo1OptimalRegion(src, region)) {
+      ++kick_trace.kick_region_rejects;
+      continue;
+    }
+    ++kick_trace.kick_regions;
+    kick_trace.kick_region_incident_edges += region.incident_edges;
+    kick_trace.kick_region_x_span
+        += static_cast<double>(std::max(0, (region.xmax - region.xmin).v));
+    kick_trace.kick_region_y_span
+        += static_cast<double>(std::max(0, (region.ymax - region.ymin).v));
+
+    const int target_row = rowForY(arch, region.center_y);
+    if (target_row < 0) {
+      ++kick_trace.kick_region_rejects;
+      continue;
+    }
+
+    std::vector<Algo1SwapCandidate> swap_candidates;
+    std::unordered_set<int> seen_dst;
+    for (int row = std::max(0, target_row - row_radius);
+         row <= std::min(arch->getNumRows() - 1, target_row + row_radius);
+         ++row) {
+      for (DetailedSeg* seg : mgr.getSegsInRow(row)) {
+        if (seg == nullptr || src->getGroupId() != seg->getRegId()) {
+          continue;
+        }
+        const DbuX target_x = std::clamp(region.center_x,
+                                         seg->getMinX(),
+                                         seg->getMaxX());
+        if (std::abs((target_x - src->getCenterX()).v)
+            > max_swap_distance.v) {
+          continue;
+        }
+        mgr.sortCellsInSeg(seg->getSegId());
+        const std::vector<Node*>& row_cells = mgr.getCellsInSeg(seg->getSegId());
+        if (row_cells.empty()) {
+          continue;
+        }
+        const auto lb = std::lower_bound(row_cells.begin(),
+                                         row_cells.end(),
+                                         target_x,
+                                         [](const Node* node, const DbuX x) {
+                                           return node->getCenterX() < x;
+                                         });
+        int nearest = static_cast<int>(lb - row_cells.begin());
+        if (nearest >= static_cast<int>(row_cells.size())) {
+          nearest = static_cast<int>(row_cells.size()) - 1;
+        }
+        const int lo = std::max(0, nearest - kNeighborCellsPerSegment);
+        const int hi = std::min(static_cast<int>(row_cells.size()) - 1,
+                                nearest + kNeighborCellsPerSegment);
+        for (int i = lo; i <= hi; ++i) {
+          Node* dst = row_cells[i];
+          if (dst == src || !movableSingleHeightCell(arch, dst)) {
+            continue;
+          }
+          if (!seen_dst.insert(dst->getId()).second) {
+            continue;
+          }
+          if (dst->getCenterX() < region.xmin - region_padding
+              || dst->getCenterX() > region.xmax + region_padding) {
+            continue;
+          }
+          if (std::abs((dst->getCenterX() - src->getCenterX()).v)
+              > max_swap_distance.v) {
+            continue;
+          }
+          Algo1SwapCandidate candidate;
+          candidate.dst = dst;
+          candidate.dst_seg = seg->getSegId();
+          candidate.center_distance
+              = std::abs((dst->getCenterX() - region.center_x).v)
+                + std::abs((dst->getCenterY() - region.center_y).v);
+          swap_candidates.push_back(candidate);
+        }
+      }
+    }
+
+    if (swap_candidates.empty()) {
+      ++kick_trace.kick_region_rejects;
+      continue;
+    }
+    kick_trace.kick_region_candidates += swap_candidates.size();
+    kick_trace.kick_candidates += swap_candidates.size();
+
+#ifdef _OPENMP
+#pragma omp parallel for num_threads(worker_count) schedule(static)
+#endif
+    for (int i = 0; i < static_cast<int>(swap_candidates.size()); ++i) {
+      swap_candidates[i].dry_gain
+          = dryRunSwapGain(src, swap_candidates[i].dst);
+    }
+    kick_trace.kick_dryrun_scored += swap_candidates.size();
+
+    std::sort(swap_candidates.begin(),
+              swap_candidates.end(),
+              [](const Algo1SwapCandidate& lhs,
+                 const Algo1SwapCandidate& rhs) {
+                if (lhs.dry_gain != rhs.dry_gain) {
+                  return lhs.dry_gain > rhs.dry_gain;
+                }
+                if (lhs.center_distance != rhs.center_distance) {
+                  return lhs.center_distance < rhs.center_distance;
+                }
+                return lhs.dst->getId() < rhs.dst->getId();
+              });
+
+    const int exact_limit = std::min<int>(kMaxExactCandidates,
+                                          swap_candidates.size());
+    for (int ci = 0; ci < exact_limit; ++ci) {
+      const Algo1SwapCandidate& candidate = swap_candidates[ci];
+      Node* dst = candidate.dst;
+      if (candidate.dry_gain < 0.0) {
+        ++kick_trace.kick_reject_hpwl;
+        continue;
+      }
+      std::unordered_map<int, odb::dbOrientType> original_orient;
+      original_orient.reserve(2);
+      original_orient[src->getId()] = src->getOrient();
+      original_orient[dst->getId()] = dst->getOrient();
+      ++kick_trace.kick_exact_scored;
+      if (mgr.trySwap(src,
+                      src->getLeft(),
+                      src->getBottom(),
+                      src_seg,
+                      dst->getLeft(),
+                      dst->getBottom(),
+                      candidate.dst_seg)) {
+        if (!journalMovesBothCells(mgr.getJournal(), src, dst)) {
+          ++kick_trace.kick_reject_legal;
+          mgr.rejectMove();
+          continue;
+        }
+        const double gain
+            = journalExactGainWithOriginalOrient(mgr.getJournal(),
+                                                 original_orient);
+        if (gain < 0.0) {
+          ++kick_trace.kick_reject_hpwl;
+          mgr.rejectMove();
+          continue;
+        }
+        kick_trace.kick_exact_gain += gain;
+        return true;
+      } else {
+        ++kick_trace.kick_reject_legal;
+      }
+    }
+    ++kick_trace.kick_region_rejects;
+  }
+  return false;
+}
+
+int applyLegalRandomKicks(DetailedMgr& mgr,
+                          Architecture* arch,
+                          const bool high_recovery_opportunity,
+                          const int kick_target,
+                          const int max_attempts,
+                          int& attempts,
+                          LsmcKickTrace& kick_trace)
+{
+  attempts = 0;
+  kick_trace.clear();
+  int legal_kicks = 0;
+  if (kick_target <= 0 || max_attempts <= 0) {
+    return legal_kicks;
+  }
+
+  std::vector<Node*> candidates = mgr.getSingleHeightCells();
+  if (candidates.empty()) {
+    return legal_kicks;
+  }
+
+  while (legal_kicks < kick_target && attempts < max_attempts) {
+    ++attempts;
+    if (generateAlgo1RegionKickSwap(
+            mgr, arch, candidates, high_recovery_opportunity, kick_trace)) {
+      kick_trace.affected_edges += mgr.getJournal().getAffectedEdges().size();
+      for (const auto& action_ptr : mgr.getJournal()) {
+        if (action_ptr->typeId() != JournalActionTypeEnum::MOVE_CELL) {
+          continue;
+        }
+        const auto* move = dynamic_cast<const MoveCellAction*>(action_ptr.get());
+        if (move == nullptr) {
+          continue;
+        }
+        addKickAnchor(arch,
+                      kick_trace,
+                      move->getNode(),
+                      move->getOrigLeft(),
+                      move->getOrigBottom());
+        addKickAnchor(arch,
+                      kick_trace,
+                      move->getNode(),
+                      move->getNewLeft(),
+                      move->getNewBottom());
+      }
+      // LSMC kicks intentionally perturb the local optimum; acceptance is
+      // decided only after the following descent reaches a new local optimum.
+      mgr.acceptMove();
+      ++legal_kicks;
+    } else {
+      mgr.rejectMove();
+    }
+  }
+  mgr.resortSegments();
+  return legal_kicks;
+}
+
+void runLsmcBooster(DetailedMgr& mgr,
+                    Architecture* arch,
+                    Network* network,
+                    const int reorder_window,
+                    const char* descent_tol,
+                    const bool high_recovery_opportunity,
+                    utl::Logger* logger)
+{
+  if (logger == nullptr || arch == nullptr || network == nullptr) {
+    return;
+  }
+
+  constexpr int kMaxIterations = 5;
+  constexpr int kFailureTolerance = 5;
+  constexpr double kPaperKickRatio = 0.10;
+  const int movable_count
+      = static_cast<int>(mgr.getSingleHeightCells().size());
+  if (movable_count <= 0) {
+    return;
+  }
+
+  const int paper_kick_target = std::max(
+      1, static_cast<int>(kPaperKickRatio * static_cast<double>(movable_count)));
+  // Keep the LSMC003 broad perturbation budget, but score the kicks with the
+  // paper Algorithm-1 optimal-region source/partner selection.
+  const int cpu_kick_cap = high_recovery_opportunity ? 512 : 192;
+  const int base_kick_target = high_recovery_opportunity ? 32 : 24;
+  const int thread_count = boundedThreadCount();
+
+  LsmcPlacementSnapshot best_snapshot = capturePlacement(mgr, network);
+  const double seed_before_hpwl = best_snapshot.hpwl;
+  LsmcKickTrace seed_trace
+      = buildAlgo2SeedTrace(mgr, arch, high_recovery_opportunity);
+  LocalDpStats seed_stats
+      = runAlgo2LocalDpDescent(mgr,
+                               arch,
+                               network,
+                               seed_trace,
+                               high_recovery_opportunity,
+                               high_recovery_opportunity ? 384 : 256);
+  const double seed_after_hpwl = currentHpwl(network);
+  const double seed_gain = seed_before_hpwl - seed_after_hpwl;
+  const char* seed_decision = "accepted";
+  if (seed_gain > 0.0) {
+    best_snapshot = capturePlacement(mgr, network);
+  } else {
+    restorePlacement(mgr, best_snapshot);
+    seed_decision = "rolled_back_no_gain";
+  }
+  logger->info(utl::DPL,
+               1234,
+               "Algo2 seed local-DP descent: seed_rows {}, seed_nodes {}, "
+               "seed_anchors {}, dp_windows considered/built/skipped {}/{}/{}, "
+               "dp_cells {}, dp_sites {}, dp_states {}, dp_transitions {}, "
+               "dp_pruned {}, dryrun_scored {}, exact_scored {}, "
+               "accepted_windows {}, rejects no_dp/exact/legal {}/{}/{}, "
+               "exact_gain {:.1f}, full_hpwl_before {:.1f}, full_hpwl_after "
+               "{:.1f}, full_gain {:.1f}, decision {}, cache_edges {}, cache "
+               "hits/misses {}/{}, runtime {:.3f} ms, thread_count {}.",
+               seed_stats.kicked_rows,
+               seed_stats.kicked_nodes,
+               seed_stats.kick_anchors,
+               seed_stats.windows_considered,
+               seed_stats.windows_built,
+               seed_stats.windows_skipped,
+               seed_stats.dp_cells,
+               seed_stats.dp_sites,
+               seed_stats.dp_states,
+               seed_stats.dp_transitions,
+               seed_stats.dp_pruned_states,
+               seed_stats.dryrun_scored,
+               seed_stats.exact_scored,
+               seed_stats.accepted_windows,
+               seed_stats.rejected_no_dp,
+               seed_stats.rejected_no_exact_gain,
+               seed_stats.rejected_legal,
+               seed_stats.exact_gain,
+               seed_before_hpwl,
+               seed_after_hpwl,
+               seed_gain,
+               seed_decision,
+               seed_stats.cache_edges,
+               seed_stats.cache_hits,
+               seed_stats.cache_misses,
+               seed_stats.runtime_ms,
+               thread_count);
+
+  const double initial_hpwl = best_snapshot.hpwl;
+  double best_hpwl = initial_hpwl;
+
+  const auto lsmc_start = std::chrono::steady_clock::now();
+  logger->info(utl::DPL,
+               1230,
+               "LSMC booster start: max_iterations {}, failure_tolerance {}, "
+               "kick_ratio {:.2f}, paper_kick_target {}, cpu_kick_cap {}, "
+               "base_kick_target {}, movable_cells {}, initial_hpwl {:.1f}, "
+               "thread_count {}, kick_mode "
+               "algo1_median_optimal_region_exact_gain_swap+"
+               "algo2_local_dp+conditional_lsmc003_descent.",
+               kMaxIterations,
+               kFailureTolerance,
+               kPaperKickRatio,
+               paper_kick_target,
+               cpu_kick_cap,
+               base_kick_target,
+               movable_count,
+               initial_hpwl,
+               thread_count);
+
+  int failures = 0;
+  int accepted = 0;
+  int rolled_back = 0;
+  int reject_no_legal_kick = 0;
+  int reject_no_gain = 0;
+  int total_kick_attempts = 0;
+  int total_legal_kicks = 0;
+  uint64_t total_dp_windows = 0;
+  uint64_t total_dp_accepted_windows = 0;
+  uint64_t total_dp_states = 0;
+  uint64_t total_dp_transitions = 0;
+  uint64_t total_dp_pruned = 0;
+  uint64_t total_dp_dryrun_scored = 0;
+  uint64_t total_dp_exact_scored = 0;
+  uint64_t total_dp_cache_edges = 0;
+  uint64_t total_dp_cache_hits = 0;
+  uint64_t total_dp_cache_misses = 0;
+  uint64_t total_kick_region_attempts = 0;
+  uint64_t total_kick_regions = 0;
+  uint64_t total_kick_region_rejects = 0;
+  uint64_t total_kick_region_candidates = 0;
+  uint64_t total_kick_region_incident_edges = 0;
+  double total_kick_region_x_span = 0.0;
+  double total_kick_region_y_span = 0.0;
+  uint64_t total_kick_candidates = 0;
+  uint64_t total_kick_dryrun_scored = 0;
+  uint64_t total_kick_exact_scored = 0;
+  uint64_t total_kick_reject_hpwl = 0;
+  uint64_t total_kick_reject_legal = 0;
+  double total_kick_exact_gain = 0.0;
+  double total_dp_exact_gain = 0.0;
+  double total_dp_full_gain = 0.0;
+  uint64_t total_fallback_called = 0;
+  double total_fallback_gain = 0.0;
+  double total_transaction_gain = 0.0;
+
+  for (int iter = 1; iter <= kMaxIterations; ++iter) {
+    const auto iter_start = std::chrono::steady_clock::now();
+    const double before_hpwl = best_hpwl;
+
+    const int kick_target
+        = std::min({paper_kick_target,
+                    cpu_kick_cap,
+                    base_kick_target << std::min(iter - 1, 4)});
+    const int max_kick_attempts = std::max(kick_target * 48, kick_target + 96);
+    int kick_attempts = 0;
+    LsmcKickTrace kick_trace;
+    const int legal_kicks = applyLegalRandomKicks(mgr,
+                                                  arch,
+                                                  high_recovery_opportunity,
+                                                  kick_target,
+                                                  max_kick_attempts,
+                                                  kick_attempts,
+                                                  kick_trace);
+    total_kick_attempts += kick_attempts;
+    total_legal_kicks += legal_kicks;
+
+    std::string descent_script = "algo2_local_dp";
+    LocalDpStats dp_stats;
+    double after_kick_hpwl = legal_kicks > 0 ? currentHpwl(network) : best_hpwl;
+    double after_dp_hpwl = after_kick_hpwl;
+    double algo2_full_gain = 0.0;
+    LsmcFallbackDescentStats fallback_stats;
+    if (legal_kicks > 0) {
+      dp_stats = runAlgo2LocalDpDescent(
+          mgr, arch, network, kick_trace, high_recovery_opportunity);
+      after_dp_hpwl = currentHpwl(network);
+      algo2_full_gain = after_kick_hpwl - after_dp_hpwl;
+      total_dp_windows += dp_stats.windows_built;
+      total_dp_accepted_windows += dp_stats.accepted_windows;
+      total_dp_states += dp_stats.dp_states;
+      total_dp_transitions += dp_stats.dp_transitions;
+      total_dp_pruned += dp_stats.dp_pruned_states;
+      total_dp_dryrun_scored += dp_stats.dryrun_scored;
+      total_dp_exact_scored += dp_stats.exact_scored;
+      total_dp_cache_edges += dp_stats.cache_edges;
+      total_dp_cache_hits += dp_stats.cache_hits;
+      total_dp_cache_misses += dp_stats.cache_misses;
+      total_kick_region_attempts += kick_trace.kick_region_attempts;
+      total_kick_regions += kick_trace.kick_regions;
+      total_kick_region_rejects += kick_trace.kick_region_rejects;
+      total_kick_region_candidates += kick_trace.kick_region_candidates;
+      total_kick_region_incident_edges
+          += kick_trace.kick_region_incident_edges;
+      total_kick_region_x_span += kick_trace.kick_region_x_span;
+      total_kick_region_y_span += kick_trace.kick_region_y_span;
+      total_kick_candidates += kick_trace.kick_candidates;
+      total_kick_dryrun_scored += kick_trace.kick_dryrun_scored;
+      total_kick_exact_scored += kick_trace.kick_exact_scored;
+      total_kick_reject_hpwl += kick_trace.kick_reject_hpwl;
+      total_kick_reject_legal += kick_trace.kick_reject_legal;
+      total_kick_exact_gain += kick_trace.kick_exact_gain;
+      total_dp_exact_gain += dp_stats.exact_gain;
+      total_dp_full_gain += algo2_full_gain;
+
+      const bool local_dp_zero_gain = dp_stats.exact_gain <= 0.0
+                                      && algo2_full_gain <= 0.0;
+      const bool transaction_still_worse = after_dp_hpwl >= before_hpwl;
+      if (local_dp_zero_gain || transaction_still_worse) {
+        fallback_stats = runLsmc003FallbackDescent(mgr,
+                                                   network,
+                                                   reorder_window,
+                                                   descent_tol,
+                                                   high_recovery_opportunity);
+        descent_script += "+" + fallback_stats.script;
+        ++total_fallback_called;
+        total_fallback_gain += fallback_stats.full_hpwl_gain;
+      }
+
+      logger->info(utl::DPL,
+                   1233,
+                   "Algo1/Algo2 hybrid LSMC repair iter {}: kicked_rows {}, "
+                   "kicked_nodes {}, kick_anchors {}, kick_region_attempts {}, "
+                   "kick_regions {}, kick_region_rejects {}, "
+                   "avg_region_edges {:.2f}, avg_region_span_dbu {:.1f}/{:.1f}, "
+                   "kick_region_candidates {}, "
