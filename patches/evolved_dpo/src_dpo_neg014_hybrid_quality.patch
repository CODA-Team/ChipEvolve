+int clampRow(Architecture* arch, const int row)
+{
+  if (arch == nullptr || arch->getNumRows() <= 0) {
+    return -1;
+  }
+  return std::clamp(row, 0, arch->getNumRows() - 1);
+}
+
+int rowForY(Architecture* arch, const DbuY y)
+{
+  if (arch == nullptr) {
+    return -1;
+  }
+  return clampRow(arch, arch->find_closest_row(y));
+}
