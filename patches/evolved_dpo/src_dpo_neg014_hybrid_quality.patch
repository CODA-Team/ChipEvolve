+DbuX nodeCenterXAt(const Node* node, const DbuX left)
+{
+  return DbuX{left.v + node->getWidth().v / 2};
+}
+
+DbuY nodeCenterYAt(const Node* node, const DbuY bottom)
+{
+  return DbuY{bottom.v + node->getHeight().v / 2};
+}
+
+void addKickAnchor(Architecture* arch,
+                   LsmcKickTrace& trace,
+                   Node* node,
+                   const DbuX left,
+                   const DbuY bottom)
+{
+  if (node == nullptr) {
+    return;
+  }
+  const int row = rowForY(arch, bottom);
+  if (row < 0) {
+    return;
+  }
+  if (trace.node_ids.insert(node->getId()).second) {
+    trace.nodes.push_back(node);
+  }
+  trace.rows.insert(row);
+  trace.anchors.push_back({node, row, nodeCenterXAt(node, left)});
+}
