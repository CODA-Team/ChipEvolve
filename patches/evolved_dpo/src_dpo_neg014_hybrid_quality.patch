+bool computeAlgo1OptimalRegion(Node* src, Algo1OptimalRegion& region)
+{
+  if (src == nullptr) {
+    return false;
+  }
+
+  std::vector<DbuX> xmin_edges;
+  std::vector<DbuX> xmax_edges;
+  std::vector<DbuY> ymin_edges;
+  std::vector<DbuY> ymax_edges;
+  xmin_edges.reserve(src->getNumPins());
+  xmax_edges.reserve(src->getNumPins());
+  ymin_edges.reserve(src->getNumPins());
+  ymax_edges.reserve(src->getNumPins());
+  int incident_edges = 0;
+  std::unordered_set<int> seen_edges;
+  for (int pi = 0; pi < src->getNumPins(); ++pi) {
+    const Edge* edge = src->getPins()[pi]->getEdge();
+    if (edge == nullptr || edge->getNumPins() <= 1
+        || !seen_edges.insert(edge->getId()).second) {
+      continue;
+    }
+
+    bool has_other_pin = false;
+    DbuX xmin = std::numeric_limits<DbuX>::max();
+    DbuX xmax = std::numeric_limits<DbuX>::min();
+    DbuY ymin = std::numeric_limits<DbuY>::max();
+    DbuY ymax = std::numeric_limits<DbuY>::min();
+    for (int pj = 0; pj < edge->getNumPins(); ++pj) {
+      const Pin* pin = edge->getPins()[pj];
+      const Node* node = pin->getNode();
+      if (node == src) {
+        continue;
+      }
+      const DbuX x = node->getCenterX() + pin->getOffsetX();
+      const DbuY y = node->getCenterY() + pin->getOffsetY();
+      xmin = std::min(xmin, x);
+      xmax = std::max(xmax, x);
+      ymin = std::min(ymin, y);
+      ymax = std::max(ymax, y);
+      has_other_pin = true;
+    }
+    if (!has_other_pin) {
+      continue;
+    }
+    xmin_edges.push_back(xmin);
+    xmax_edges.push_back(xmax);
+    ymin_edges.push_back(ymin);
+    ymax_edges.push_back(ymax);
+    ++incident_edges;
+  }
+
+  if (xmin_edges.empty() || xmax_edges.empty() || ymin_edges.empty()
+      || ymax_edges.empty()) {
+    return false;
+  }
+  region.xmin = medianDbuX(xmin_edges);
+  region.xmax = medianDbuX(xmax_edges);
+  region.ymin = medianDbuY(ymin_edges);
+  region.ymax = medianDbuY(ymax_edges);
+  if (region.xmax < region.xmin) {
+    std::swap(region.xmin, region.xmax);
+  }
+  if (region.ymax < region.ymin) {
+    std::swap(region.ymin, region.ymax);
+  }
+  region.center_x = DbuX{(region.xmin.v + region.xmax.v) / 2};
+  region.center_y = DbuY{(region.ymin.v + region.ymax.v) / 2};
+  region.incident_edges = incident_edges;
+  return true;
+}
