+int floorDiv(const int a, const int b)
+{
+  int q = a / b;
+  const int r = a % b;
+  if (r != 0 && ((r > 0) != (b > 0))) {
+    --q;
+  }
+  return q;
+}
+
+int ceilDiv(const int a, const int b)
+{
+  return -floorDiv(-a, b);
+}
+
+DbuX alignSiteCeil(const Architecture::Row* row, const DbuX x)
+{
+  const int spacing = row->getSiteSpacing().v;
+  const int site = ceilDiv(x.v - row->getLeft().v, spacing);
+  return DbuX{row->getLeft().v + site * spacing};
+}
