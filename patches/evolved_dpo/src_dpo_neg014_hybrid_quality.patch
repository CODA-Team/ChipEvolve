+DbuX medianDbuX(std::vector<DbuX>& values)
+{
+  std::sort(values.begin(), values.end());
+  const int n = static_cast<int>(values.size());
+  return DbuX{(values[(n - 1) / 2].v + values[n / 2].v) / 2};
+}
+
+DbuY medianDbuY(std::vector<DbuY>& values)
+{
+  std::sort(values.begin(), values.end());
+  const int n = static_cast<int>(values.size());
+  return DbuY{(values[(n - 1) / 2].v + values[n / 2].v) / 2};
+}
