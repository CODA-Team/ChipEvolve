+LsmcPlacementSnapshot capturePlacement(DetailedMgr& mgr, Network* network)
+{
+  LsmcPlacementSnapshot snapshot;
+  snapshot.cells.reserve(network->getNumNodes());
+  for (const auto& node_ptr : network->getNodes()) {
+    Node* node = node_ptr.get();
+    if (node == nullptr || node->isFixed() || !node->isPlaced()
+        || node->getType() != Node::CELL) {
+      continue;
+    }
+
+    LsmcPlacementSnapshot::CellState state;
+    state.node = node;
+    state.left = node->getLeft();
+    state.bottom = node->getBottom();
+    state.orient = node->getOrient();
+    state.placed = node->isPlaced();
+    for (const DetailedSeg* seg : mgr.getReverseCellToSegs(node->getId())) {
+      if (seg != nullptr) {
+        state.segment_ids.push_back(seg->getSegId());
+      }
+    }
+    snapshot.cells.push_back(std::move(state));
+  }
+  snapshot.hpwl = currentHpwl(network);
+  return snapshot;
+}
+
+void restorePlacement(DetailedMgr& mgr, const LsmcPlacementSnapshot& snapshot)
+{
+  mgr.rejectMove();
+  for (const auto& state : snapshot.cells) {
+    if (state.node != nullptr && state.node->isPlaced()) {
+      mgr.eraseFromGrid(state.node);
+    }
+  }
+
+  mgr.removeAllCellsFromSegments();
+  for (const auto& state : snapshot.cells) {
+    Node* node = state.node;
+    if (node == nullptr) {
+      continue;
+    }
+    node->setLeft(state.left);
+    node->setBottom(state.bottom);
+    node->setPlaced(state.placed);
+    if (!state.placed) {
+      continue;
+    }
+    mgr.paintInGrid(node);
+    node->adjustCurrOrient(state.orient);
+    for (const int seg_id : state.segment_ids) {
+      if (seg_id >= 0 && seg_id < mgr.getNumSegments()) {
+        mgr.addCellToSegment(node, seg_id);
+      }
+    }
+  }
+  mgr.resortSegments();
+}
