+bool journalMovesBothCells(const Journal& journal,
+                           const Node* first,
+                           const Node* second)
+{
+  bool saw_first = false;
+  bool saw_second = false;
+  for (const auto& action_ptr : journal) {
+    if (action_ptr->typeId() != JournalActionTypeEnum::MOVE_CELL) {
+      continue;
+    }
+    const auto* move = dynamic_cast<const MoveCellAction*>(action_ptr.get());
+    if (move == nullptr) {
+      continue;
+    }
+    saw_first = saw_first || move->getNode() == first;
+    saw_second = saw_second || move->getNode() == second;
+  }
+  return saw_first && saw_second;
+}
+
+std::vector<JournalMoveState> collectJournalMoves(const Journal& journal)
+{
+  std::vector<JournalMoveState> moves;
+  moves.reserve(journal.size());
+  for (const auto& action_ptr : journal) {
+    if (action_ptr->typeId() != JournalActionTypeEnum::MOVE_CELL) {
+      continue;
+    }
+    const auto* move = dynamic_cast<const MoveCellAction*>(action_ptr.get());
+    if (move == nullptr) {
+      continue;
+    }
+    moves.push_back({move->getNode(),
+                     move->getOrigLeft(),
+                     move->getOrigBottom(),
+                     move->getNewLeft(),
+                     move->getNewBottom()});
+  }
+  return moves;
+}
