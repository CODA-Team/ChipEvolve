@@ -0,0 +1,2620 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2018-2025, The OpenROAD Authors
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cmath>
