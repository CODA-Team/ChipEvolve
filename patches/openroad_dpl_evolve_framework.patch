diff --git a/src/dpl_evolve/src/EvolveLegalizer.cpp b/src/dpl_evolve/src/EvolveLegalizer.cpp
new file mode 100644
index 0000000000..6a0655cbe0
--- /dev/null
+++ b/src/dpl_evolve/src/EvolveLegalizer.cpp
@@ -0,0 +1,198 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2018-2025, The OpenROAD Authors
+
+#include "EvolveLegalizer.h"
+
+#include <chrono>
+#include <cstdlib>
+#include <dlfcn.h>
+#include <string>
+
+#include "EvolvePluginApi.h"
+#include "utl/Logger.h"
+
+namespace dpl_evolve {
+
+using utl::DPL;
+
+namespace {
+
+class StageTimer
+{
+ public:
+  StageTimer(EvolveLegalizer* legalizer, const char* name, const char* status)
+      : legalizer_(legalizer),
+        name_(name),
+        status_(status),
+        start_(std::chrono::steady_clock::now())
+  {
+  }
+
+  ~StageTimer()
+  {
+    const auto end = std::chrono::steady_clock::now();
+    const auto elapsed
+        = std::chrono::duration<double, std::milli>(end - start_).count();
+    legalizer_->recordStage(name_, status_, elapsed);
+  }
+
+ private:
+  EvolveLegalizer* legalizer_ = nullptr;
+  const char* name_ = nullptr;
+  const char* status_ = nullptr;
+  std::chrono::steady_clock::time_point start_;
+};
+
+}  // namespace
+
+struct PluginCallbackState
+{
+  utl::Logger* logger = nullptr;
+  EvolveHooks* hooks = nullptr;
+};
+
+void pluginMetricInt(void* user_data, const char* name, const int value)
+{
+  auto* state = static_cast<PluginCallbackState*>(user_data);
+  state->logger->metric(name, value);
+}
+
+void pluginRunDiamondCompatible(void* user_data)
+{
+  auto* state = static_cast<PluginCallbackState*>(user_data);
+  state->hooks->run_diamond_compatible();
+}
+
+void pluginRunNegotiationRepair(void* user_data, const int run_abacus)
+{
+  auto* state = static_cast<PluginCallbackState*>(user_data);
+  state->hooks->run_negotiation_repair(run_abacus != 0);
+}
+
+EvolveLegalizer::EvolveLegalizer(utl::Logger* logger, EvolveHooks hooks)
+    : logger_(logger), hooks_(std::move(hooks))
+{
+}
+
+void EvolveLegalizer::recordStage(const char* name,
+                                  const char* status,
+                                  const double elapsed_ms)
+{
+  telemetry_.record(name, status, elapsed_ms);
+  logger_->info(DPL,
+                1201,
+                "DPL-Evolve stage {}: {} ({:.2f} ms).",
+                name,
+                status,
+                elapsed_ms);
+}
+
+void EvolveLegalizer::run(const EvolveContext& context)
+{
+  logger_->info(DPL,
+                1200,
+                "Legalizing using constrained DPL-Evolve framework.");
+  logger_->metric("dpl_evolve__framework__entry", 1);
+  logger_->metric("dpl_evolve__framework__negotiation_requested",
+                  context.negotiation_requested ? 1 : 0);
+  logger_->metric("dpl_evolve__framework__abacus_requested",
+                  context.abacus_requested ? 1 : 0);
+
+  if (tryRunExternalPlugin(context)) {
+    return;
+  }
+
+  runRelaxedGuidanceStage(context);
+  runRowAssignmentStage(context);
+
+  if (context.negotiation_requested) {
+    runNegotiationRepairStage(context);
+  } else {
+    runDiamondCompatibleStage(context);
+  }
+
+  runBoundedPolishStage(context);
+}
+
+bool EvolveLegalizer::tryRunExternalPlugin(const EvolveContext& context)
+{
+  const char* plugin_path = std::getenv("DPL_EVOLVE_PLUGIN_SO");
+  if (plugin_path == nullptr || std::string(plugin_path).empty()) {
+    logger_->metric("dpl_evolve__plugin__enabled", 0);
+    return false;
+  }
+
+  logger_->metric("dpl_evolve__plugin__enabled", 1);
+  logger_->info(DPL, 1202, "Loading DPL-Evolve plugin: {}", plugin_path);
+
+  void* handle = dlopen(plugin_path, RTLD_NOW | RTLD_LOCAL);
+  if (handle == nullptr) {
+    logger_->error(DPL, 1203, "Failed to load DPL-Evolve plugin: {}", dlerror());
+  }
+
+  dlerror();
+  auto run = reinterpret_cast<DplEvolveRunV1>(dlsym(handle, "dpl_evolve_run_v1"));
+  const char* symbol_error = dlerror();
+  if (symbol_error != nullptr) {
+    dlclose(handle);
+    logger_->error(DPL,
+                   1204,
+                   "DPL-Evolve plugin is missing dpl_evolve_run_v1: {}",
+                   symbol_error);
+  }
+
+  PluginCallbackState state{logger_, &hooks_};
+  DplEvolveCallbacksV1 callbacks;
+  callbacks.user_data = &state;
+  callbacks.metric_int = pluginMetricInt;
+  callbacks.run_diamond_compatible = pluginRunDiamondCompatible;
+  callbacks.run_negotiation_repair = pluginRunNegotiationRepair;
+
+  DplEvolveContextV1 plugin_context;
+  plugin_context.negotiation_requested = context.negotiation_requested ? 1 : 0;
+  plugin_context.abacus_requested = context.abacus_requested ? 1 : 0;
+  plugin_context.max_displacement_x = context.max_displacement_x;
+  plugin_context.max_displacement_y = context.max_displacement_y;
+
+  const int rc = run(&plugin_context, &callbacks);
+  dlclose(handle);
+  if (rc != 0) {
+    logger_->error(DPL, 1205, "DPL-Evolve plugin returned failure code {}.", rc);
+  }
+  logger_->metric("dpl_evolve__plugin__status", 1);
+  return true;
+}
+
+void EvolveLegalizer::runRelaxedGuidanceStage(const EvolveContext&)
+{
+  StageTimer timer(this, "relaxed_guidance", "skipped");
+  logger_->metric("dpl_evolve__stage_relaxed_guidance__active", 0);
+}
+
+void EvolveLegalizer::runRowAssignmentStage(const EvolveContext&)
+{
+  StageTimer timer(this, "row_assignment", "skipped");
+  logger_->metric("dpl_evolve__stage_row_assignment__active", 0);
+}
+
+void EvolveLegalizer::runDiamondCompatibleStage(const EvolveContext&)
+{
+  StageTimer timer(this, "diamond_compatible", "active");
+  logger_->metric("dpl_evolve__stage_diamond_compatible__active", 1);
+  hooks_.run_diamond_compatible();
+}
+
+void EvolveLegalizer::runNegotiationRepairStage(const EvolveContext& context)
+{
+  StageTimer timer(this, "negotiation_repair", "active");
+  logger_->metric("dpl_evolve__stage_negotiation_repair__active", 1);
+  hooks_.run_negotiation_repair(context.abacus_requested);
+}
+
+void EvolveLegalizer::runBoundedPolishStage(const EvolveContext&)
+{
+  StageTimer timer(this, "bounded_polish", "skipped");
+  logger_->metric("dpl_evolve__stage_bounded_polish__active", 0);
+}
+
+}  // namespace dpl_evolve
diff --git a/src/dpl_evolve/src/EvolveLegalizer.h b/src/dpl_evolve/src/EvolveLegalizer.h
new file mode 100644
index 0000000000..5f3b05f389
--- /dev/null
+++ b/src/dpl_evolve/src/EvolveLegalizer.h
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2018-2025, The OpenROAD Authors
+
+#pragma once
+
+#include <functional>
+#include <string>
+#include <utility>
+
+#include "EvolveContext.h"
+#include "EvolveTelemetry.h"
+
+namespace utl {
+class Logger;
+}
+
+namespace dpl_evolve {
+
+struct EvolveHooks
+{
+  std::function<void()> run_diamond_compatible;
+  std::function<void(bool run_abacus)> run_negotiation_repair;
+};
+
+class EvolveLegalizer
+{
+ public:
+  EvolveLegalizer(utl::Logger* logger, EvolveHooks hooks);
+
+  void run(const EvolveContext& context);
+  const EvolveTelemetry& telemetry() const { return telemetry_; }
+  void recordStage(const char* name, const char* status, double elapsed_ms);
+
+ private:
+  void runRelaxedGuidanceStage(const EvolveContext& context);
+  void runRowAssignmentStage(const EvolveContext& context);
+  void runDiamondCompatibleStage(const EvolveContext& context);
+  void runNegotiationRepairStage(const EvolveContext& context);
+  void runBoundedPolishStage(const EvolveContext& context);
+  bool tryRunExternalPlugin(const EvolveContext& context);
+
+  utl::Logger* logger_ = nullptr;
+  EvolveHooks hooks_;
+  EvolveTelemetry telemetry_;
+};
+
+}  // namespace dpl_evolve
diff --git a/src/dpl_evolve/src/EvolvePluginApi.h b/src/dpl_evolve/src/EvolvePluginApi.h
new file mode 100644
index 0000000000..aac51422b2
--- /dev/null
+++ b/src/dpl_evolve/src/EvolvePluginApi.h
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2018-2025, The OpenROAD Authors
+
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Minimal C ABI for out-of-tree DPL-Evolve top-level plugins.
+//
+// The first version exposes orchestration callbacks only.  This lets an agent
+// compile a tiny shared object and choose stage order without relinking
+// OpenROAD.  Deeper placement-data APIs can be added with a new ABI version.
+
+typedef struct DplEvolveContextV1
+{
+  int negotiation_requested;
+  int abacus_requested;
+  int max_displacement_x;
+  int max_displacement_y;
+} DplEvolveContextV1;
+
+typedef struct DplEvolveCallbacksV1
+{
+  void* user_data;
+  void (*metric_int)(void* user_data, const char* name, int value);
+  void (*run_diamond_compatible)(void* user_data);
+  void (*run_negotiation_repair)(void* user_data, int run_abacus);
+} DplEvolveCallbacksV1;
+
+typedef int (*DplEvolveRunV1)(const DplEvolveContextV1* context,
+                              const DplEvolveCallbacksV1* callbacks);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/src/dpl_evolve/src/EvolveTelemetry.h b/src/dpl_evolve/src/EvolveTelemetry.h
new file mode 100644
index 0000000000..eaf4716174
--- /dev/null
+++ b/src/dpl_evolve/src/EvolveTelemetry.h
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Copyright (c) 2018-2025, The OpenROAD Authors
+
+#pragma once
+
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace dpl_evolve {
+
+struct EvolveStageRecord
+{
+  std::string name;
+  std::string status;
+  double elapsed_ms = 0.0;
+};
+
+class EvolveTelemetry
+{
+ public:
+  void record(std::string name, std::string status, const double elapsed_ms)
+  {
+    stages_.push_back({std::move(name), std::move(status), elapsed_ms});
+  }
+
+  const std::vector<EvolveStageRecord>& stages() const { return stages_; }
+
+ private:
+  std::vector<EvolveStageRecord> stages_;
+};
+
+}  // namespace dpl_evolve
